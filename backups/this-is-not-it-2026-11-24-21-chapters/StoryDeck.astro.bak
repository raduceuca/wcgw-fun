---
/* One player, several versions. The tabs swap the cut; the verdict and the note change with it.
   Behaviour lives in the story page's script (data-deck). Without script the first version plays. */
interface Cut {
  v: number
  at: string
  len: string
  verdict: string
  note: string
}
interface Props {
  base: string
  cuts: Cut[]
}
const { base, cuts } = Astro.props
const first = cuts[0]
---

<figure class="deck" data-deck>
  <video controls playsinline preload="none" poster={`${base}/cut-v${first.v}.webp`} width="544" height="680">
    <source src={`${base}/cut-v${first.v}.mp4`} type="video/mp4" />
  </video>
  <figcaption>
    {
      cuts.length > 1 && (
        <p class="tabs">
          {cuts.map((c, i) => (
            <button
              type="button"
              class="tab"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-v={c.v}
              data-src={`${base}/cut-v${c.v}.mp4`}
              data-poster={`${base}/cut-v${c.v}.webp`}
              data-at={c.at}
              data-len={c.len}
              data-verdict={c.verdict}
              data-note={c.note}
            >
              v{c.v}
            </button>
          ))}
        </p>
      )
    }
    <p class="meta">Version <span class="num" data-f="v">{first.v}</span> · <span class="num" data-f="at">{first.at}</span> · <span class="num" data-f="len">{first.len}</span></p>
    <p class="verdict" data-f="verdict">{first.verdict}</p>
    <p class="note" data-f="note">{first.note}</p>
  </figcaption>
</figure>

<style>
  .deck {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    column-gap: 1.5rem;
    align-items: start;
    margin: 0;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--hair);
    background: var(--hair);
  }
  figcaption > * + * { margin-top: 0.35em; }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9em;
    margin-bottom: 0.7em;
  }
  .tab {
    padding: 0 0 0.1em;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--soft);
    font: inherit;
    font-family: var(--sans);
    font-size: 0.8em;
    font-variant-numeric: lining-nums tabular-nums;
    cursor: pointer;
  }
  .tab[aria-pressed='true'] {
    color: var(--ink);
    border-bottom-color: var(--pencil);
  }
  .tab:focus-visible {
    outline: 2px solid var(--pencil);
    outline-offset: 0.2em;
  }
  .meta,
  .note { color: var(--soft); }
  .note { font-size: 0.92em; line-height: 1.45; }
  @media (max-width: 30rem) {
    .deck { grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr); column-gap: 1rem; }
  }
</style>
