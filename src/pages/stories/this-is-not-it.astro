  /* What I typed. A hair line down the side, nothing else. */
  .prompt {
    margin-inline: 0;
    padding-left: 1.4em;
    border-left: 1px solid var(--hair);
  }
  .prompt p + p { margin-top: 0.55em; }

  /* A turning point: the prompt at display size, underlined by the pencil. */
  .shout {
    margin: 1.9em 0;
    padding: 0;
  }
  .shout p {
    font-size: clamp(1.8rem, 1.25rem + 2.6vw, 2.7rem);
