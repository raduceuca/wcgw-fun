      transition: clip-path 0.3s var(--ease-pencil);
    }
  }
  :global(.js) .it:not(.found)::after { clip-path: inset(0 100% 0 0); }
  :global(.js) .it.found::after { clip-path: inset(0); }

  /* One ask */
  .cta { margin-top: var(--act-space); }
  .ask {
    font-size: clamp(1.8rem, 1.25rem + 2.6vw, 2.7rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin-bottom: 0.4em;
  }

  .colophon { margin-top: var(--act-space); padding-top: var(--act-space); border-top: 1px solid var(--hair); }
  .colophon .signs { row-gap: 0.45em; font-size: 0.92em; line-height: 1.5; }
  .closing { padding-top: var(--act-space); }

  /* Some pictures break the page: edge to edge, with the caption back on the reading column. */
  .bleed {
    width: 100vw;
    margin: var(--act-space) calc(50% - 50vw) 0;
  }
  .bleed + .act { margin-top: var(--act-space); }
