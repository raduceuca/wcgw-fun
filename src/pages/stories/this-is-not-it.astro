<script>
  // The film plays muted in the hero; one button gives it its sound back, from the top.
  const hero = document.querySelector<HTMLVideoElement>('[data-hero]')
  const sound = document.querySelector<HTMLButtonElement>('[data-sound]')
  if (hero && sound) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.removeAttribute('autoplay')
      hero.pause()
      hero.controls = true
    }
    sound.addEventListener('click', () => {
      hero.muted = !hero.muted
      if (!hero.muted) {
        hero.currentTime = 0
        void hero.play()
      }
      sound.textContent = (hero.muted ? sound.dataset.on : sound.dataset.off) ?? ''
      sound.setAttribute('aria-pressed', String(!hero.muted))
    })
  }

  // Small looping clips behave like GIFs, unless motion is unwelcome.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-loop]').forEach((v) => {
      v.removeAttribute('autoplay')
      v.pause()
      v.controls = true
    })
  }

  // Decks: one player, several versions.
  document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
    const video = deck.querySelector('video')
    const tabs = [...deck.querySelectorAll<HTMLButtonElement>('[data-v]')]
    if (!video) return
    const put = (f: string, text = '') => {
      const el = deck.querySelector(`[data-f="${f}"]`)
      if (el) el.textContent = text
    }
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)))
        video.pause()
        video.poster = tab.dataset.poster ?? ''
        video.src = tab.dataset.src ?? ''
        video.load()
        put('v', tab.dataset.v)
        put('at', tab.dataset.at)
        put('len', tab.dataset.len)
        put('verdict', tab.dataset.verdict)
        put('note', tab.dataset.note)
      }),
    )
    // Only one film at a time.
    video.addEventListener('play', () => {
      document.querySelectorAll('video').forEach((v) => {
        if (v !== video && !v.hasAttribute('data-hero') && !v.hasAttribute('data-loop')) v.pause()
      })
      if (hero && !hero.muted) hero.pause()
    })
  })

  // Hear a twig.
  document.querySelectorAll<HTMLButtonElement>('[data-snd]').forEach((b) =>
    b.addEventListener('click', () => void new Audio(b.dataset.snd).play().catch(() => {})),
  )

  // The ending, pinned: the note crossing the middle of the window picks the frame beside it.
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const beats = [...reel.querySelectorAll('[data-beat]')]
    const frames = [...reel.querySelectorAll('[data-frame]')]
    const mid = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return
          const at = beats.indexOf(e.target)
          beats.forEach((b, i) => b.classList.toggle('on', i === at))
          frames.forEach((f, i) => f.classList.toggle('on', i === at))
        }),
      { rootMargin: '-50% 0px -50% 0px' },
    )
    beats.forEach((b) => mid.observe(b))
  })

  // The key can be pressed: four photographs, played as stop motion. The real F12 presses it too.
  const key = document.querySelector<HTMLButtonElement>('[data-press]')
  if (key) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches
    const steps: [string, number][] = calm
      ? [['3', 0], ['0', 420]]
      : [['1', 0], ['2', 80], ['3', 160], ['2', 460], ['1', 530], ['0', 600]]
    let busy = false
    const press = () => {
      if (busy) return
      busy = true
      steps.forEach(([f, ms]) => setTimeout(() => (key.dataset.f = f), ms))
      setTimeout(() => (busy = false), steps[steps.length - 1][1] + 40)
    }
    key.addEventListener('click', press)
    addEventListener('keydown', (e) => e.key === 'F12' && press())
  }

  // The paper falls off the beach once half the picture is in view, however tall it is.
  const beach = document.querySelector('.beach')
  const scene = beach?.querySelector('.scene')
  if (beach && scene) {
    const fall = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return
        beach.classList.add('is-in')
        fall.disconnect()
      },
      { threshold: 0.5 },
    )
    fall.observe(scene)
  }

  // F12 still shows you the real thing.
  console.log('%cThis is it.', 'font: italic 32px Georgia, serif')
  console.log('In Dreamweaver, F12 opened your page in the browser. Here it opened this.')

  // Before and after: the range input moves the line.
  document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((cmp) => {
    const range = cmp.querySelector('input')
    if (!range) return
    const set = () => cmp.style.setProperty('--x', `${range.value}%`)
    range.addEventListener('input', set)
    set()
  })

  // The pencil underlines a shout as it comes into view; the + × dividers blink.
  const seen = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return
        e.target.classList.add('is-in')
        seen.unobserve(e.target)
      }),
    { threshold: 0.6 },
  )
  document.querySelectorAll('.shout, .blink, .its li').forEach((el) => seen.observe(el))
</script>

<style>
