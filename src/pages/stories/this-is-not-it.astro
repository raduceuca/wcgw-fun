  .cap p + p { margin-top: 0; }
  .poster { max-width: 22rem; }
  .poster img { display: block; width: 100%; height: auto; border: 1px solid var(--hair); background: var(--hair); }

  /* Find it: plain until found */
  :global(.js) .it:not(.found) { font-style: inherit; }
