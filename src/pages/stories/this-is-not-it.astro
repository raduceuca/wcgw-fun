---
import Logo from '../../components/Logo.astro'
import StoryCompare from '../../components/StoryCompare.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { consent } from '../../copy'
import { pages, site } from '../../site'
import '../../styles/home.css'

/* Story: how one picture for a LinkedIn post turned into the film "This is not it."
   Ten chapters at most (24 Nov 2026): the reader does the picking, the saying no, the pressing and
   the tapping; the prose only sets each one up. The long version, 21 chapters, is kept in
   backups/this-is-not-it-2026-11-24-21-chapters/.
   Told in the order it happened, in the first person. Quotes are as typed except for spelling slips,
   fixed on 20 Nov 2026 at Radu's request, and the prompts he asked to have tidied (the film request,
   the Steve Jobs line, the Volvo line and the one after version 3).
   Keep the lowercase, the fragments and the bluntness: they are the evidence.
   Copy rules: no "not X, it's Y", no aphorisms, no feelings Radu did not type. Dry humour from facts only.
   Every game has a plain reading: without script, all the text and one film are on the page. */

const base = '/stories/this-is-not-it'
const film = { versions: 25, seconds: 119.5, fps: 30, bpm: 120, pictures: 49 }

/** The LinkedIn post that started it. Source: LinkedIn post analytics export, 20 November 2026. */
const post = { impressions: 13866, reached: 8432, reactions: 49, comments: 32, saves: 30 }

/** How tightly picture and sound land. Measured on the rendered films against the sound's own list of events. */
const hits = { of: 52, before: 27, after: 32 }

/* The gutter counts from the first prompt, as Radu tells it (24 Nov 2026): T+1day is most of the work, T+4days the polish.
   Clock times are Bucharest time, from the timestamps of the files and the chat. */
const frames = Math.round(film.seconds * film.fps)
const length = `${Math.floor(film.seconds / 60)}:${String(Math.floor(film.seconds % 60)).padStart(2, '0')}`

/** The two rounds of pictures. `mine` is the one I kept. */
const rounds = {
  one: [
    { src: '01-a', name: 'A. An empty selection.', alt: 'An empty blue selection box with a rope pulling one corner, above the word Left.', mine: true },
    { src: '01-b', name: 'B. Robots.', alt: 'A row of small robots combing an orange scribble into a browser window.' },
    { src: '01-c', name: 'C. An old monitor.', alt: 'An old beige monitor next to a laptop on a desk.' },
  ],
  two: [
    { src: '02-voice', name: 'The voice', alt: 'A black voice waveform bursting through a selection box.' },
    { src: '02-bin', name: 'The bin', alt: 'A crumpled selection box on the floor next to a waste bin.' },
    { src: '02-tombstone', name: 'The grave', alt: 'A grey stone slab on grass inside a selection box, with a dead rose, above the word Left.', mine: true },
    { src: '02-dragged', name: 'The getaway', alt: 'A selection box almost entirely dragged off the page.' },
  ],
}

/** What I was shown, and what I typed after it. `v: 0` is the book that came first. */
const tries = [
  { v: 0, name: 'The book', file: 'book', note: 'Illustrated plates, laid out like an article.', typed: ['I don’t know if this format is ever going to work', 'Starting from these frames, can we make a 60-second video manifesto with web technologies? Kinetic typography and lots of small animations. Think "Designed in California" from Apple.'] },
  { v: 1, note: 'Small illustrated workmen and too many sizes of type.', typed: ['look, imagine you are at Apple and Steve Jobs is reviewing this tomorrow morning'] },
  { v: 2, note: 'One size of type, more sound.', typed: ['not bad v2, think you need to work on rhythm and dramatism.'] },
  { v: 3, note: 'Seven seconds shorter. I had asked for rhythm and drama.', typed: ['feels too fast. every beat of the story needs its own idea.'] },
  { v: 4, note: 'Started again without the illustrations.', typed: ['do the f12 key real, a 3d render, or something that gets pushed as the climax'] },
  { v: 8, note: 'A photograph of a key, and a selection box that gives up and leaves.', typed: ['think we need piano sounds, look at this'] },
  { v: 13, note: 'Wood, stone, water, leaves.', typed: ['natural sounds need more work, maybe meet half way natural and the ones you had before'] },
  { v: 16, note: 'The page became a card with a hole in it, and the card fell away.', typed: ['amazing, put my x handle in there on the final card.'] },
  { v: 22, note: 'Soft piano, a beach behind the page.', typed: ['ship it still feels weak, can we get some actual booster rocket clouds forming at bottom as it launches?'] },
  { v: 23, note: 'Rocket clouds, a pencil sketch, rolling credits.', typed: ['we drew pictures of it, ‘we just drew pictures of it’ maybe so it’s clear this is what we actually did?'] },
  { v: 25, note: 'Piano and nylon guitar.', typed: [] },
].map((t) => ({ ...t, name: t.name ?? `Version ${t.v}`, file: t.file ?? `cut-v${t.v}` }))

/** The afternoon the ending was made, by the clock (Bucharest, 20 November 2026):
    what I typed and when, then the version that came back. */
const afternoon = [
  { at: '15:59', said: 'transition here is lazy.', v: 14, got: 'Every shape gets its own selection box.', alt: 'Nine pastel shapes, each inside its own selection box, above the line Push it.' },
  { at: '16:01', said: 'or rather have just the drag handles, but the whole bg is a photo', v: 14, got: 'The photo fills the frame. The handles stay.', alt: 'A photo of leaves fills the frame, with eight selection handles and the line That’s it.' },
  { at: '16:16', said: 'like they were a window into something, or the page was a cardboard with a cutout in the center', v: 16, got: 'The page is a card with a hole in it. It falls.', alt: 'A paper card with a photo-shaped hole tilting as it falls, the handles left behind.' },
  { at: '16:24', said: 'amazing, put my x handle in there on the final card.', v: 17, got: 'My handle is on the last card.', alt: 'The leaves with That’s it. and the credit Radu Ceuca, @raduceuca, wcgw.fun.' },
  { at: '16:40', said: 'Need one final touch of cinematography genius there', v: 18, got: 'The last frame says “This is it.”', alt: 'The leaves with the line This is it.' },
  { at: '16:49', said: 'this is not it → this is "still" not it → this is it?', v: 19, got: 'The middle state.', alt: 'The photo of leaves selected inside a paper page, above the line This is still not it.' },
  { at: '16:52', said: 'took a quarter of a century should move to final slide with full bleed picture, right?', v: 20, got: 'The quarter of a century is on the last frame.', alt: 'The leaves with This is it. Took a quarter of a century.' },
  { at: '17:11', said: 'the image must have a deeper meaning.', v: 21, got: 'A Caribbean beach. The wireframe is gone.', alt: 'A photo of a palm over turquoise water selected inside a paper page, above the line This is still not it.' },
]

/** Things I typed that day that lean on the word "it". Spelling fixed, nothing else. */
const its = [
  'does it work? will people get it?',
  'this is not it. That is the title. it’s like a book.',
  'i don’t need it to move. it can remain static.',
  'you select it as if it was an image, but then you get to actually push it',
  'this is it should be on the final final frame',
  'the rhythmicity of it stood out. then it hit me.',
  'no real reason, sometimes it’s gut',
]
/** Split a line around every whole word "it", so each one can be found. */
const mark = (line: string) => line.split(/\b(it)\b/i)
const itCount = its.reduce((n, line) => n + (mark(line).length - 1) / 2, 0)

/** Everything there is to find, in page order. The order is printed before it is found, `what` after
    (the script fills in the ones that depend on the reader). Every one can be done by touch. */
const finds = [
  { id: 'sound', to: 'film', say: 'Turn it up.', what: 'Piano and guitar.' },
  { id: 'reply', to: 's1', say: 'Pick it.', what: 'An empty selection.' },
  { id: 'grave', to: 'round-two', say: 'Pick it again.', what: 'The grave.' },
  { id: 'its', to: 's3', say: 'Find it.', what: `All ${itCount}, no help.` },
  { id: 'ship', to: 's4', say: 'Ship it.' },
  { id: 'no', to: 's4', say: 'Say no to it.', what: 'To the end.' },
  { id: 'render', to: 's5', say: 'Uncover it.', what: 'Horrific.' },
  { id: 'key', to: 's5', say: 'Push it.', what: 'Rectangles.' },
  { id: 'beat', to: 's6', say: 'Beat it.' },
  { id: 'figma', to: 's8', say: 'Bury it.', what: 'Figma.' },
  { id: 'note', to: 'note', say: 'Say it.', what: `Version ${film.versions + 1}.` },
]
---

<BaseLayout
  title="The Accidental Manifesto. WCGW"
  description={`I asked for a picture for a LinkedIn post and ended up with a ${length} film. See where you would have stopped.`}
  social={`I asked for a picture for a LinkedIn post. ${film.versions} versions later it was a film. Say when you would have stopped.`}
  page={pages.thisIsNotIt}
  image={`${base}/og.png`}
  imageAlt="The Accidental Manifesto. I asked for a picture for a post. I got a film. 25 versions, zero timelines. Beside it, a thumb about to press an F12 key inside a selection box."
  creator="@raduceuca"
>
  <a href="#s1" class="skip">Skip to the story</a>

  <div class="page">
    <header class="masthead">
      <a class="home" href="/" aria-label="WCGW home"><Logo /></a>
    </header>

    <nav class="toc" data-toc aria-label="Contents"></nav>

    <aside class="finds" data-finds aria-label="Found on this page">
      <button class="tally" type="button" popovertarget="finds">
        <span data-last></span>
        <span class="count"><span class="call-out">Find the easter eggs. </span><span class="num" data-n>0</span> of <span class="num">{finds.length}</span> found</span>
      </button>
      <p class="sr-only" aria-live="polite" data-told></p>
      <div class="list" id="finds" popover>
        <p class="state" data-state>This is not it.</p>
        <ol>
          {finds.map((f) => <li data-find={f.id} data-what={f.what}><a href={`#${f.to}`}>{f.say}</a> <span data-what-now></span></li>)}
        </ol>
      </div>
    </aside>

    <main>
      <section class="hero" id="film">
        <div class="hero-film">
          <video data-hero autoplay muted loop playsinline preload="metadata" poster={`${base}/poster.jpg`} width="1080" height="1350">
            <source src={`${base}/this-is-not-it.mp4`} type="video/mp4" />
          </video>
          <p class="hero-bar">
            <button class="link" type="button" data-sound data-on="Sound on" data-off="Sound off" aria-pressed="false">Sound on</button>
            <span><abbr class="fact" title={`${film.seconds} seconds`}>{length}</abbr>, playing now</span>
          </p>
        </div>
        <div class="hero-copy">
          <h1>
            <span class="beat">The Accidental Manifesto.</span>
          </h1>
          <p class="lede">
            From an image for a LinkedIn post to a short manifesto film about design.<br/>
          </p>
          <p class="lede dare jsonly">
            This page hides <abbr class="fact" title="Easter eggs. The corner counts them as you find them.">{finds.length} things</abbr>.
          </p>
          <p class="call"><a class="link" href="#s1">Start looking ↓</a></p>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s1">
        <p class="gutter"><span class="num">Morning</span> Picture</p>
        <div class="body" data-pick>
          <h2 id="s1">Once Upon a Time in Claude.</h2>
          <blockquote class="prompt">
            <p>Preparing this post for LinkedIn, create a nice visual for it with Tony from Amplifiers</p>
          </blockquote>
          <p>
            Tony, the guide inside <a class="link" href="https://getamplifiers.com" rel="noopener">Amplifiers</a>,
            delivered three options. Which one is it?
          </p>
          <figure class="shots three">
            <div>
              {
                rounds.one.map((o) => (
                  <div>
                    <div class="opt" data-opt data-mine={o.mine}>
                      <img src={`${base}/${o.src}.webp`} alt={o.alt} width="640" height="800" loading="lazy" />
                      <button class="hit" type="button" aria-label={`Pick ${o.name}`} />
                    </div>
                    <p class="v">{o.name}</p>
                  </div>
                ))
              }
            </div>
          </figure>
          <p class="answer" data-answer>A. The box you drag in a design tool, with nothing inside and one word under it.</p>
          <p>I asked Claude to stare into the emptiness some more.</p>

          <p>
            Context: Ioana Teleanu asked designers who left Figma what they use now, and read the replies as most of them never
            leaving. I left late last year, which is too long for a comment. So I wrote a post, and posts
            need pictures. Right?
          </p>
        </div>
      </section>

      <figure class="bleed" id="round-two" data-pick>
        <div class="strip four">
          {
            rounds.two.map((o) => (
              <div class="opt" data-opt data-mine={o.mine}>
                <img src={`${base}/${o.src}.webp`} alt={o.alt} width="640" height="800" loading="lazy" />
                <button class="hit" type="button" aria-label={`Pick ${o.name}`} />
              </div>
            ))
          }
        </div>
        <figcaption class="cap"><div class="row"><div class="body">
          <p>Round two. Which one would you put on LinkedIn?</p>
          <p class="answer" data-answer>I kept the grave.</p>
        </div></div></figcaption>
      </figure>

      <section class="act row step" aria-labelledby="s2">
        <p class="gutter"><span class="num">T+60min</span> Tombstone</p>
        <div class="body">
          <h2 id="s2">The Post Always Rings Twice.</h2>
          <blockquote class="prompt">
            <p>Like the 1st one. Does it work? will people get it?</p>
            <p>Can we use bold, not ultrabold for copy? And maybe make it a wee bit smaller? think Apple ads from 80s.</p>
          </blockquote>
          <figure class="poster">
            <img src={`${base}/03-final.webp`} alt="The final poster: a selected tombstone and the word Left. in bold." width="640" height="800" loading="lazy" />
          </figure>
          <p>
            Couple hours later it was on LinkedIn. A tombstone. Great work, Radu! By that evening, it had
            <abbr class="fact" title={`${post.impressions.toLocaleString('en-US')} impressions, ${post.reached.toLocaleString('en-US')} people reached. LinkedIn post analytics export, 20 November 2026`}>about 14,000 impressions</abbr>.
            A quarter of the people who saw it were product designers. Some of them work at Figma.
          </p>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s3">
        <p class="gutter"><span class="num">T+1day</span> Wordplay</p>
        <div class="body">
          <h2 id="s3">Eight its and a maybe.</h2>
          <p>I read <abbr class="fact" title="The word it, counted in the LinkedIn post of 20 November 2026, it’s included: where it sits, cleans it up, shapes it, tries to break it, explores it, builds it, until it’s right, a mockup of it">the post</abbr> back. Shapes it, tries to break it, explores it, builds it. Then it hit me.</p>
          <blockquote class="prompt">
            <p>Is there "it" wordplay here that we can use for more dramat?</p>
            <p>Maybe you can start off with a funny provocative thing about design.</p>
          </blockquote>
          <p>My prompts kept saying it too. <span class="jsonly">Click every “it” below.</span></p>
        </div>
      </section>

      <div class="hunt" data-hunt>
        <p class="score">
          <span aria-live="polite"><span class="num" data-found>0</span> of <span class="num">{itCount}</span>. <em data-miss></em></span>
          <button class="link" type="button" data-show>Show me</button>
        </p>
        <ul class="its">
          {
            its.map((line) => (
              <li>
                <blockquote class="prompt">
                  <p>{line.split(' ').map((word, i) => <Fragment>{i > 0 && ' '}{mark(word).length > 1 ? <span class="word">{mark(word).map((part, j) => (j % 2 ? <em class="it">{part}</em> : part))}</span> : word}</Fragment>)}</p>
                </blockquote>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="row">
        <div class="body">
          <p>
            I got a short story called <em>This is not it</em>. First line: funny thing about design, it’s
            always about it.
          </p>
        </div>
      </div>

      <section class="act row step" aria-labelledby="s4">
        <p class="gutter"><span class="num">T+1day</span> Hollywood!</p>
        <div class="body">
          <h2 id="s4">Thank You for Not Shipping.</h2>
          <p>
            At first, it dreamt of being a book. Then there were {film.versions} versions of a film. Here are the ones
            worth arguing about. <span class="jsonly">Ship it the moment you would have. Or say what I said.</span>
          </p>
        </div>
      </section>

      <div class="wide say" data-say data-versions={film.versions}>
        <figure class="screen">
          <video controls playsinline muted loop preload="none" poster={`${base}/${tries[0].file}.webp`} width="544" height="680" data-screen>
            <source src={`${base}/${tries[0].file}.mp4`} type="video/mp4" />
          </video>
        </figure>
        <div class="talk">
          <ol class="thread" data-thread>
            {
              tries.map((t, i) => (
                <li class:list={{ now: i === 0 }} data-try data-v={t.v} data-name={t.name} data-src={`${base}/${t.file}.mp4`} data-poster={`${base}/${t.file}.webp`}>
                  <p class="back">
                    {t.v ? <Fragment>Version <span class="num">{t.v}</span></Fragment> : t.name}. {t.note}
                  </p>
                  {
                    t.typed.length > 0 && (
                      <blockquote class="prompt">
                        {t.typed.map((line) => <p>{line}</p>)}
                      </blockquote>
                    )
                  }
                </li>
              ))
            }
          </ol>
          <p class="end" data-end aria-live="polite"></p>
          <p class="call">
            <button class="link" type="button" data-no>Not it.</button>
            <button class="link" type="button" data-ship>Ship it.</button>
          </p>
        </div>
      </div>

      <section class="act night" aria-labelledby="s5">
        <div class="row">
          <p class="gutter"><span class="num">T+1day</span> F12</p>
          <div class="body">
            <h2 id="s5">Dial F12 for Mockup.</h2>
            <p>The film ends on F12, the Dreamweaver key that opened your page in a browser.</p>
          </div>
        </div>

        <div class="wide duo">
          <blockquote class="shout">
            <p>Oh no, the 3D you did is just horrific.</p>
            <footer>Me, after version 5.</footer>
          </blockquote>
          <figure class="cmpfig">
            <StoryCompare
              before={`${base}/key-3d.webp`}
              after={`${base}/key-real.webp`}
              beforeLabel="Version 5"
              afterLabel="Version 8"
              alt="A photographed beige F12 key with a fingertip pressing it, compared with a glossy 3D render of the same key."
            />
            <figcaption>Drag the line. A render on one side, a photograph with a finger on the other.</figcaption>
          </figure>
        </div>

        <div class="wide duo flip">
          <figure class="press">
            <button class="key" type="button" data-press data-f="0" aria-label="Hold the F12 key">
              <img src={`${base}/press-0.webp`} alt="A beige F12 key on paper." width="820" height="1025" loading="lazy" draggable="false" />
              <img src={`${base}/press-1.webp`} alt="" width="820" height="1025" loading="lazy" draggable="false" />
              <img src={`${base}/press-2.webp`} alt="" width="820" height="1025" loading="lazy" draggable="false" />
              <img src={`${base}/press-3.webp`} alt="" width="820" height="1025" loading="lazy" draggable="false" />
            </button>
          </figure>
          <div class="push">
            <p class="ask jsonly">Push it. Hold it down to see this page the way a rectangle tool does.</p>
            <blockquote class="prompt">
              <p>It’s a real button. You select it as if it was an image, but then you get to actually push it</p>
              <p>must see how the F12 button is pressed, even if we render this as stop motion animation png sequence</p>
            </blockquote>
          </div>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s6">
        <p class="gutter"><span class="num">T+1day</span> Piano</p>
        <div class="body">
          <h2 id="s6">Dude, Where’s My Beat?</h2>
          <blockquote class="prompt">
            <p>piano piece is not in sync or related to the rest of the video, seems like bad mixing / mastering</p>
          </blockquote>
          <p>
            So Claude retimed the whole picture to
            <abbr class="fact" title="The tempo of the score from version 11 on">{film.bpm}</abbr> beats a minute. In the final
            cut, <abbr class="fact" title={`The sharpest changes between frames in the rendered film. Version 24: ${hits.before} of ${hits.of}. Version 25: ${hits.after} of ${hits.of}. Measured against the sound's own list of events.`}>{hits.after} of the {hits.of} sharpest hits</abbr>
            land within a frame of their sound.
          </p>
          <div class="beat-game" data-beat-game data-bpm={film.bpm} data-fps={film.fps} data-film={`${hits.after} of ${hits.of}`}>
            <p>Beat that. Four beats to get ready, then sixteen taps.</p>
            <p class="voices">
              <button type="button" class="tab" aria-pressed="false" data-voice={`${base}/snd-beep.wav`}>beep</button>
              <button type="button" class="tab" aria-pressed="true" data-voice={`${base}/snd-twig.wav`}>twig</button>
              <button type="button" class="tab" aria-pressed="false" data-voice={`${base}/snd-hammer.wav`}>hammer</button>
            </p>
            <button type="button" class="pad" data-pad>Start</button>
            <div class="taps" data-taps aria-hidden="true"></div>
            <p class="score" data-score aria-live="polite"></p>
          </div>
          <blockquote class="prompt">
            <p>each sound must come from nature, like a twig snapping. think of the Volvo turn signal story.</p>
            <p>natural sounds need more work, maybe half natural and half the ones you had before</p>
          </blockquote>
          <p>
            <a class="link" href="https://news.yahoo.com/volvo-snapped-stick-turn-signal-175500792.html" rel="noopener">Volvo built its turn signal from a snapped stick</a>.
            The film clicks in twigs and small hammers.
          </p>
          <blockquote class="shout">
            <p>I am NOT a robot, right?</p>
            <footer>Me, hearing a synthetic voice play me.</footer>
          </blockquote>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s7">
        <p class="gutter"><span class="num">T+1day</span> Endings</p>
        <div class="body">
          <h2 id="s7">The Neverending Ending.</h2>
          <p>
            The last ten seconds changed
            <abbr class="fact" title="Versions 14, 16, 17, 18, 19, 20 and 21 all changed the ending">seven</abbr>
            times between 15:59 and 17:11.
          </p>
        </div>
      </section>

      <div class="wide reel" data-reel>
        {
          afternoon.map((n, i) => (
            <Fragment>
              <div class:list={['said', { on: i === 0 }]} style={`--i:${i + 1}`} data-beat>
                <p class="when num">{n.at}</p>
                <blockquote><p>{n.said}</p></blockquote>
              </div>
              <figure class:list={['frame', { on: i === 0 }]} data-frame>
                <img src={`${base}/end-${i + 1}.webp`} alt={n.alt} width="720" height="900" loading="lazy" />
                <figcaption>
                  Version <span class="num">{n.v}</span>. {n.got}
                </figcaption>
              </figure>
            </Fragment>
          ))
        }
      </div>

      <figure class="bleed beach">
        <div class="scene">
          <img class="wide-img" src={`${base}/beach-wide.webp`} alt="A Caribbean beach: turquoise water and a palm leaning over white sand." width="1632" height="699" loading="lazy" />
          <div class="card" aria-hidden="true"></div>
          <div class="win" aria-hidden="true"></div>
        </div>
        <figcaption class="cap"><div class="row"><p class="body">I asked for a deeper meaning and then for a Caribbean beach. No real reason. It is aspirational, and sometimes it’s gut.</p></div></figcaption>
      </figure>

      <section class="act row day" aria-labelledby="s8">
        <p class="gutter"><span class="num">T+4days</span> Back</p>
        <div class="body">
          <h2 id="s8">Weekend at Figma’s.</h2>
          <p>
            Most of this was done on T+1day. Then life happened. I didn’t get a chance to come back and polish until today.
          </p>
          <p>The old tombstone named Figma. The new one mourns all rectangle tools.</p>
          <figure class="cmpfig" data-from="94">
            <StoryCompare
              before={`${base}/tomb-v22.webp`}
              after={`${base}/tomb-v25.webp`}
              beforeLabel="T+1day"
              afterLabel="T+4days"
              alt="Two tombstones. T+1day: Late last year I left Figma. Not repositioned. Left. T+4days: Late last year, my rectangle tools drew their last breath. They didn’t suffer."
            />
            <figcaption>Drag to bury Figma, or dig it up.</figcaption>
          </figure>
          <blockquote class="shout">
            <p>I really want to post it today.</p>
            <footer>Me, yesterday at 10:38am.</footer>
          </blockquote>
        </div>
      </section>

      <section class="act row step" aria-labelledby="point">
        <p class="gutter">The point</p>
        <div class="body">
          <h2 id="point">Back to the F12.</h2>
          <p>
            I’ve been waiting for this since 8th grade, when I built my first website in Macromedia
            Dreamweaver. Designing the actual thing, not a mockup of it.
          </p>
          <p>No rectangle drawing software can work at the speed of my thoughts.</p>
          <p>
            I typed short messages and complained a lot.
          </p>
        </div>
      </section>

      <section class="row cta" id="note">
        <div class="body">
          <p class="ask">Somewhere there is a version {film.versions + 1}.<br />It is still not it.</p>
          <form class="note-form" data-note data-to={site.email} data-version={film.versions + 1}>
            <p class="voices">
              {['Keep', 'Tweak', 'Rework', 'Cut'].map((w) => <button type="button" class="tab" aria-pressed={w === 'Rework' ? 'true' : 'false'} data-verdict={w}>{w}</button>)}
            </p>
            <textarea rows="3" aria-label={`Your note for version ${film.versions + 1}`} placeholder="lowercase is fine" data-clarity-mask="true"></textarea>
            <button class="link" type="submit">Send me the note</button>
          </form>
          <p>
            WCGW does this for product teams, by the month. Write to
            <a class="link" href={`mailto:${site.email}`}>{site.email}</a> or
            <a class="link" href="https://x.com/raduceuca" target="_blank" rel="noopener">@raduceuca</a>.
          </p>
        </div>
      </section>

      <section class="act row colophon" aria-labelledby="colophon">
        <p class="gutter">Credits</p>
        <div class="body">
          <h2 id="colophon" class="sr-only">Credits</h2>
          <dl class="signs">
            <dt>Directed by</dt>
            <dd>Radu Ceucă, by complaining.</dd>
            <dt>Code, piano, edit</dt>
            <dd>Claude & Neon. It wrote this page too, and argued back.</dd>
            <dt>Sets and props</dt>
            <dd>
              <a class="link" href="https://getamplifiers.com" rel="noopener">Amplifiers</a>.
              <span class="num">{film.pictures}</span> pictures and
              <span class="num">4</span> cotton-wool clouds.
            </dd>
            <dt>Film</dt>
            <dd>
              A web page, screenshotted <span class="num">{frames.toLocaleString('en-US')}</span> times.
              <span class="num">{film.seconds}</span> seconds at <span class="num">{film.fps}</span> frames a second. No video editor was opened, or harmed.
            </dd>
            <dt>The post</dt>
            <dd>
              <span class="num">{post.impressions.toLocaleString('en-US')}</span> impressions,
              <span class="num">{post.reached.toLocaleString('en-US')}</span> people reached,
              <span class="num">{post.reactions}</span> reactions, <span class="num">{post.comments}</span> comments.
            </dd>
            <dt>Prompts</dt>
            <dd>Radu Ceucă.</dd>
            <dt>Set</dt>
            <dd>Bucharest.</dd>
            <dt>Sound</dt>
            <dd>
              Piano and nylon guitar from the FluidR3 soundfont. Twigs and hammers from <a class="link" href="https://opengameart.org" rel="noopener">OpenGameArt</a>.
            </dd>
            <dt>Typeface</dt>
            <dd>EB Garamond</dd>
            <dt>Timelines</dt>
            <dd><span class="num">0</span>.</dd>
          </dl>
        </div>
      </section>
    </main>

    <footer class="row">
      <div class="body foot">
        <p>© <span id="year">2026</span> <a class="link" href="/">WCGW</a>, the studio of Radu Ceucă.</p>
        <p><a class="link" href="/stories">More stories</a></p>
        {
          site.clarityId && (
            <p>
              <a class="link" href="/privacy">{consent.privacy}</a> ·{' '}
              <button class="link" type="button" data-consent-open>{consent.reopen}</button>
            </p>
          )
        }
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  // Found: every game reports here once. The count sits in the corner and opens the list; nothing is stored.
  const tally = document.querySelector<HTMLElement>('[data-finds]')
  const list = tally?.querySelector<HTMLElement>('.list')
  const rows = [...(tally?.querySelectorAll<HTMLElement>('[data-find]') ?? [])]
  let fade = 0
  function find(id: string, what?: string) {
    const row = rows.find((r) => r.dataset.find === id)
    if (!tally || !row || row.classList.contains('got')) return
    row.classList.add('got')
    const now = row.querySelector('[data-what-now]')
    if (now) now.textContent = what ?? row.dataset.what ?? ''
    const line = (row.textContent ?? '').replace(/\s+/g, ' ').trim()
    const n = rows.filter((r) => r.classList.contains('got')).length
    const all = n === rows.length
    const state = all ? 'This is it.' : n > 1 ? 'This is still not it.' : 'This is not it.'
    const set = (sel: string, text: string) => tally.querySelector(sel)!.replaceChildren(text)
    set('[data-n]', String(n))
    set('[data-state]', state)
    set('[data-last]', all ? state : line)
    set('[data-told]', `${line} ${n} of ${rows.length} found. ${all ? state : ''}`)
    tally.classList.add('new')
    tally.classList.toggle('all', all)
    clearTimeout(fade)
    if (!all) fade = window.setTimeout(() => tally.classList.remove('new'), 3500)
  }
  list?.addEventListener('click', (e) => e.target instanceof HTMLAnchorElement && list.hidePopover())

  // The film plays muted in the hero; one button gives it its sound back, from the top.
  const hero = document.querySelector<HTMLVideoElement>('[data-hero]')
  const sound = document.querySelector<HTMLButtonElement>('[data-sound]')
  if (hero && sound) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.removeAttribute('autoplay')
      hero.pause()
      hero.controls = true
    }
    sound.addEventListener('click', () => {
      hero.muted = !hero.muted
      if (!hero.muted) {
        hero.currentTime = 0
        void hero.play()
        find('sound')
      }
      sound.textContent = (hero.muted ? sound.dataset.on : sound.dataset.off) ?? ''
      sound.setAttribute('aria-pressed', String(!hero.muted))
    })
  }

  // Pick one. A wrong picture is told so; mine gets the handles and the answer.
  document.querySelectorAll<HTMLElement>('[data-pick]').forEach((game) => {
    const answer = game.querySelector<HTMLElement>('[data-answer]')
    if (!answer) return
    const mine = answer.textContent ?? ''
    answer.setAttribute('aria-live', 'polite')
    answer.textContent = ''
    const opts = [...game.querySelectorAll<HTMLElement>('[data-opt]')]
    opts.forEach((opt) =>
      opt.querySelector('button')?.addEventListener('click', () => {
        const right = opt.hasAttribute('data-mine')
        opt.classList.add(right ? 'yes' : 'no')
        answer.classList.toggle('unsaid', !right)
        answer.textContent = right ? `This is it. ${mine}` : 'This is not it.'
        if (!right) return
        opts.forEach((o) => o.querySelector('button')?.remove())
        find(game.id ? 'grave' : 'reply')
      }),
    )
  })

  // Find it: every "it" becomes a button in the sentence.
  const hunt = document.querySelector<HTMLElement>('[data-hunt]')
  if (hunt) {
    const found = hunt.querySelector('[data-found]')
    const miss = hunt.querySelector('[data-miss]')
    const show = hunt.querySelector<HTMLButtonElement>('[data-show]')
    const all = [...hunt.querySelectorAll<HTMLElement>('.it')].map((em) => {
      const b = document.createElement('button')
      b.type = 'button'
      b.textContent = em.textContent
      b.setAttribute('aria-pressed', 'false')
      em.replaceChildren(b)
      return em
    })
    let helped = false
    const spot = (em: HTMLElement) => {
      em.classList.add('found')
      if (miss) miss.textContent = ''
      em.querySelector('button')?.setAttribute('aria-pressed', 'true')
      const line = em.closest('li')
      line?.classList.toggle('done', !line.querySelector('.it:not(.found)'))
      const left = all.filter((x) => !x.classList.contains('found')).length
      if (found) found.textContent = String(all.length - left)
      if (left) return
      show?.remove()
      if (!helped) find('its')
    }
    all.forEach((em) => em.addEventListener('click', () => spot(em), { once: true }))
    // Any other word is told what every wrong picture is told.
    hunt.querySelector('.its')?.addEventListener('click', (e) => {
      const line = (e.target as Element).closest('li')
      if (!miss || !line || (e.target as Element).closest('.it')) return
      miss.textContent = 'This is not it.'
      line.classList.add('huh')
      line.addEventListener('animationend', () => line.classList.remove('huh'), { once: true })
    })
    show?.addEventListener('click', () => {
      helped = true
      all.forEach((em, i) => setTimeout(() => spot(em), i * 60))
    })
  }

  // Say when: the cuts come one at a time. "Not it" sends what I typed and brings the next one.
  const say = document.querySelector<HTMLElement>('[data-say]')
  const screen = say?.querySelector<HTMLVideoElement>('[data-screen]')
  if (say && screen) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches
    const total = Number(say.dataset.versions)
    const tries = [...say.querySelectorAll<HTMLElement>('[data-try]')]
    const thread = say.querySelector<HTMLElement>('[data-thread]')
    const end = say.querySelector<HTMLElement>('[data-end]')
    const no = say.querySelector<HTMLButtonElement>('[data-no]')
    const ship = say.querySelector<HTMLButtonElement>('[data-ship]')
    let at = 0
    const play = () => {
      if (!calm) void screen.play().catch(() => {})
    }
    const down = () => thread?.scrollTo({ top: thread.scrollHeight, behavior: calm ? 'auto' : 'smooth' })
    no?.addEventListener('click', () => {
      tries[at].classList.add('told')
      if (end) end.textContent = ''
      if (at === tries.length - 1) {
        find('no')
        if (end) end.innerHTML = `Then <a class="link" href="#note">write version ${total + 1}</a>.`
        no.remove()
        ship?.remove()
        return
      }
      at++
      const next = tries[at]
      next.classList.add('now')
      screen.poster = next.dataset.poster ?? ''
      screen.src = next.dataset.src ?? ''
      play()
      no.textContent = 'Not it.'
      if (ship) ship.hidden = false
      down()
    })
    ship?.addEventListener('click', () => {
      const v = Number(tries[at].dataset.v)
      const more = total - v
      if (!end || !no) return
      end.textContent = !more
        ? `Version ${v}. This is it.`
        : v
          ? `You’d have shipped version ${v}. I asked for ${more} more.`
          : `You’d have shipped the book. I asked for ${more} versions of a film.`
      find('ship', v ? `Version ${v}.` : 'The book.')
      ship.hidden = true
      no.textContent = more ? 'Keep going' : 'Still not it.'
      down()
    })
    if (!calm) {
      const first = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return
          first.disconnect()
          if (at === 0) play()
        },
        { threshold: 0.5 },
      )
      first.observe(screen)
    }
    // Only one film with sound at a time.
    screen.addEventListener('volumechange', () => {
      if (hero && !hero.muted && !screen.muted) hero.pause()
    })
  }

  // Beat that: sixteen taps against the film's tempo, judged by the film's own rule, one frame either way.
  const beat = document.querySelector<HTMLElement>('[data-beat-game]')
  if (beat) {
    const every = 60 / Number(beat.dataset.bpm)
    const frame = 1000 / Number(beat.dataset.fps)
    const ready = 4
    const count = 16
    const pad = beat.querySelector<HTMLButtonElement>('[data-pad]')
    const score = beat.querySelector('[data-score]')
    const row = beat.querySelector('[data-taps]')
    const voices = [...beat.querySelectorAll<HTMLButtonElement>('[data-voice]')]
    const ticks = Array.from({ length: count }, () => row?.appendChild(document.createElement('i')))
    let ctx: AudioContext | undefined
    const buffers = new Map<string, AudioBuffer>()
    const voice = () => voices.find((v) => v.getAttribute('aria-pressed') === 'true')?.dataset.voice ?? ''
    const load = async () => {
      ctx ??= new AudioContext()
      await ctx.resume()
      const url = voice()
      let buffer = buffers.get(url)
      if (!buffer) {
        buffer = await ctx.decodeAudioData(await (await fetch(url)).arrayBuffer())
        buffers.set(url, buffer)
      }
      return { ctx, buffer }
    }
    const click = (c: AudioContext, buffer: AudioBuffer, when = 0) => {
      const s = c.createBufferSource()
      s.buffer = buffer
      s.connect(c.destination)
      s.start(when)
    }
    voices.forEach((v) =>
      v.addEventListener('click', async () => {
        voices.forEach((x) => x.setAttribute('aria-pressed', String(x === v)))
        const { ctx: c, buffer } = await load()
        click(c, buffer)
      }),
    )
    let zero = 0 // performance time of the first beat to tap; 0 when nothing is playing
    let hits = new Set<number>()
    const start = async () => {
      if (!pad) return
      pad.textContent = 'Ready'
      hits = new Set()
      ticks.forEach((t) => t?.removeAttribute('class'))
      if (score) score.textContent = ''
      document.querySelectorAll('video').forEach((v) => !v.muted && v.pause())
      const { ctx: c, buffer } = await load()
      const t0 = c.currentTime + 0.25
      for (let i = 0; i < ready + count; i++) click(c, buffer, t0 + i * every)
      const heard = (t0 - c.currentTime + (c.outputLatency || c.baseLatency || 0) + ready * every) * 1000
      zero = performance.now() + heard
      for (let i = ready; i > 0; i--) setTimeout(() => (pad.textContent = String(i)), heard - i * every * 1000)
      setTimeout(() => (pad.textContent = 'Tap'), heard - every * 400)
      setTimeout(() => {
        zero = 0
        pad.textContent = 'Again'
        if (score) score.textContent = `${hits.size} of ${count} within a frame. The film: ${beat.dataset.film}.`
        const [landed, of] = (beat.dataset.film ?? '').split(' of ').map(Number)
        if (hits.size / count > landed / of) find('beat', `${hits.size} of ${count}.`)
      }, heard + count * every * 1000)
    }
    const tap = (when: number) => {
      const i = Math.round((when - zero) / (every * 1000))
      const tick = ticks[i]
      if (!tick || tick.className) return
      const on = Math.abs(when - zero - i * every * 1000) <= frame
      tick.className = on ? 'on' : 'off'
      if (on) hits.add(i)
    }
    const press = (when: number) => (zero ? tap(when) : pad?.textContent === 'Ready' ? undefined : void start())
    pad?.addEventListener('pointerdown', (e) => press(e.timeStamp))
    pad?.addEventListener('keydown', (e) => {
      if (e.repeat || (e.key !== ' ' && e.key !== 'Enter')) return
      e.preventDefault()
      press(e.timeStamp)
    })
  }

  // Your note for the next version, in the four words of my review page. It opens your own mail.
  const note = document.querySelector<HTMLFormElement>('[data-note]')
  if (note) {
    const words = [...note.querySelectorAll<HTMLButtonElement>('[data-verdict]')]
    words.forEach((w) => w.addEventListener('click', () => words.forEach((x) => x.setAttribute('aria-pressed', String(x === w)))))
    note.querySelector('textarea')?.addEventListener('change', (e) => (e.target as HTMLTextAreaElement).value.trim() && find('note'))
    note.addEventListener('submit', (e) => {
      e.preventDefault()
      const word = words.find((w) => w.getAttribute('aria-pressed') === 'true')?.dataset.verdict
      const body = note.querySelector('textarea')?.value ?? ''
      location.href = `mailto:${note.dataset.to}?subject=${encodeURIComponent(`Version ${note.dataset.version}: ${word}`)}&body=${encodeURIComponent(body)}`
    })
  }

  // The ending, pinned: the note crossing the middle of the window picks the frame beside it.
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const beats = [...reel.querySelectorAll('[data-beat]')]
    const frames = [...reel.querySelectorAll('[data-frame]')]
    const mid = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return
          const at = beats.indexOf(e.target)
          beats.forEach((b, i) => b.classList.toggle('on', i === at))
          frames.forEach((f, i) => f.classList.toggle('on', i === at))
        }),
      { rootMargin: '-50% 0px -50% 0px' },
    )
    beats.forEach((b) => mid.observe(b))
  })

  // The key can be held: four photographs, played as stop motion. While it is down, the page is drawn as rectangles.
  const key = document.querySelector<HTMLButtonElement>('[data-press]')
  if (key) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches
    const root = document.documentElement
    const least = 900
    let since = 0
    let timers: number[] = []
    const run = (steps: [number, string][]) => {
      timers.forEach(clearTimeout)
      timers = steps.map(([ms, f]) =>
        window.setTimeout(() => {
          key.dataset.f = f
          root.classList.toggle('mock', f === '3')
          if (f === '3') find('key')
        }, ms),
      )
    }
    const down = () => {
      if (since) return
      since = performance.now()
      run(calm ? [[0, '3']] : [[0, '1'], [80, '2'], [160, '3']])
    }
    const up = () => {
      if (!since) return
      const wait = Math.max(0, least - (performance.now() - since))
      since = 0
      const back = timers
      timers = []
      run(calm ? [[wait, '0']] : [[wait, '2'], [wait + 70, '1'], [wait + 140, '0']])
      timers.push(...back)
    }
    const pulse = () => {
      down()
      up()
    }
    key.addEventListener('pointerdown', (e) => {
      if (e.button) return
      key.setPointerCapture(e.pointerId)
      down()
    })
    key.addEventListener('pointerup', up)
    key.addEventListener('pointercancel', up)
    key.addEventListener('contextmenu', (e) => e.preventDefault())
    key.addEventListener('click', (e) => e.detail === 0 && pulse())
    addEventListener('keydown', (e) => e.key === 'F12' && !e.repeat && pulse())
  }

  // The paper falls off the beach once half the picture is in view, however tall it is.
  const beach = document.querySelector('.beach')
  const scene = beach?.querySelector('.scene')
  if (beach && scene) {
    const fall = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return
        beach.classList.add('is-in')
        fall.disconnect()
      },
      { threshold: 0.5 },
    )
    fall.observe(scene)
  }

  // Contents: one line per chapter, taken from its heading (its first sentence when long) so the two never drift.
  const toc = document.querySelector<HTMLElement>('[data-toc]')
  if (toc) {
    const chapters = [...document.querySelectorAll<HTMLElement>('.act[aria-labelledby]')].map((section) => {
      const a = document.createElement('a')
      a.href = `#${section.getAttribute('aria-labelledby')}`
      const heading = (section.querySelector('h2')?.textContent ?? '').replace(/\s+/g, ' ').trim()
      const title = document.createElement('span')
      title.textContent = (heading.length > 44 && heading.match(/^.*?[.?!](?=\s|$)/)?.[0]) || heading
      a.append(title)
      toc.append(a)
      return { section, a }
    })

    // Mark the chapter being read. Ticks turn light on the dark chapter and step aside for full-width pictures.
    const dark = document.querySelector('.night')
    const pictures = [...document.querySelectorAll('.bleed :is(.strip, .wide-img)')]
    const covers = (el: Element | null, y: number) => {
      if (!el) return false
      const r = el.getBoundingClientRect()
      return r.top <= y && y <= r.bottom
    }
    const mark = () => {
      if (!toc.offsetHeight) return
      const now = chapters.filter((c) => c.section.getBoundingClientRect().top <= innerHeight * 0.2).pop()
      const at = chapters.map(({ a }) => {
        const r = a.getBoundingClientRect()
        const y = (r.top + r.bottom) / 2
        return { a, dark: covers(dark, y), over: pictures.some((p) => covers(p, y)) }
      })
      toc.classList.toggle('dark', covers(dark, innerHeight / 2))
      at.forEach((t) => {
        t.a.classList.toggle('dark', t.dark)
        t.a.classList.toggle('over', t.over)
        if (t.a === now?.a) t.a.setAttribute('aria-current', 'location')
        else t.a.removeAttribute('aria-current')
      })
    }
    let due = 0
    const soon = () => {
      cancelAnimationFrame(due)
      due = requestAnimationFrame(mark)
    }
    addEventListener('scroll', soon, { passive: true })
    addEventListener('resize', soon)
    mark()
  }

  // F12 still shows you the real thing.
  console.log('%cThis is it.', 'font: italic 32px Georgia, serif')
  console.log('In Dreamweaver, F12 opened your page in the browser. Here it opened this.')

  // Before and after: the range input moves the line.
  document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((cmp) => {
    const range = cmp.querySelector('input')
    if (!range) return
    const set = () => cmp.style.setProperty('--x', `${range.value}%`)
    // Dragged all the way to the side worth seeing: the render, or the grave without Figma.
    const dug = cmp.closest('[data-from]') ? () => Number(range.value) <= 10 && find('figma') : () => Number(range.value) >= 90 && find('render')
    range.addEventListener('input', set)
    range.addEventListener('input', dug)
    range.value = cmp.closest<HTMLElement>('[data-from]')?.dataset.from ?? range.value
    set()
  })

  // The pencil underlines a shout as it comes into view.
  const seen = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return
        e.target.classList.add('is-in')
        seen.unobserve(e.target)
      }),
    { threshold: 0.6 },
  )
  document.querySelectorAll('.shout').forEach((el) => seen.observe(el))
</script>

<style>
  .home {
    display: block;
    color: inherit;
  }
  .home:focus-visible {
    outline: 2px solid var(--pencil);
    outline-offset: 0.2em;
  }

  /* Three widths: the reading column, a wide one for the hero, and edge to edge. */
  .wide {
    width: min(100vw - 2.75rem, 66rem);
    margin-inline: calc(50% - min(50vw - 1.375rem, 33rem));
  }

  /* The film is the hero. It is already playing. The title starts under the logo, where every page's
     does; the film runs out to the wide edge. */
  .hero {
    display: grid;
    gap: 2rem;
    width: calc(50% + min(50vw - 1.375rem, 33rem));
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    padding-bottom: var(--act-space);
  }
  .hero h1 { margin-top: 0; }
  .hero h1 em { font-style: italic; }
  .hero-film video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--hair);
    background: var(--hair);
  }
  .hero-bar {
    display: flex;
