  /* Every "it" I typed, in italic as the film sets it, and marked with the blue pencil. */
  .hunt { margin-top: var(--beat); }
  /* My prompts, strewn across the window. One with every “it” found gets the handles. */
  .its {
    list-style: none;
    display: grid;
    gap: 1.1rem;
    margin-block: 1.5rem 3rem;
    padding: 0;
    line-height: 1.3;
  }
  /* --w fits a bubble to its own line breaks. */
  .its li { width: fit-content; max-width: min(92%, var(--w, 100%)); font-size: calc(1em * var(--s)); rotate: var(--r); }
  .its li:nth-child(7n + 1) { --s: 1.45; --r: -2deg; --w: 8.2em; }
  .its li:nth-child(7n + 2) { --s: 1.1; --r: 1.5deg; --w: 11em; justify-self: end; }
  .its li:nth-child(7n + 3) { --s: 1.25; --r: 0.8deg; --w: 10.4em; justify-self: center; }
  .its li:nth-child(7n + 4) { --s: 1.15; --r: -1.2deg; --w: 11em; }
  .its li:nth-child(7n + 5) { --s: 1.5; --r: 2deg; --w: 9.4em; justify-self: end; }
  .its li:nth-child(7n + 6) { --s: 1.3; --r: 1.4deg; --w: 11.8em; }
  .its li:nth-child(7n + 7) { --s: 1.15; --r: -2.4deg; justify-self: end; }
  .its .prompt { display: block; margin: 0; }
