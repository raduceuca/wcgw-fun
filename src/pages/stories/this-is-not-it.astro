---
import Logo from '../../components/Logo.astro'
import StoryCompare from '../../components/StoryCompare.astro'
import StoryDeck from '../../components/StoryDeck.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { consent } from '../../copy'
import { pages, site } from '../../site'
import '../../styles/home.css'

/* Story: how one picture for a LinkedIn post turned into the film "This is not it."
   Told in the order it happened, in the first person, with the prompts as typed.
   Quotes are as typed except for spelling slips, fixed on 20 Nov 2026 at Radu's request, and the
   four prompts he asked to have tidied: the film request and the Steve Jobs line in step 06,
   the Volvo pull quote in step 10 (as typed: "each sfx must come from a natural element, like twigs
   breaking. think volvo philosophy of signal blinker"),
   and the pull quote in step 07 (as typed: "feels too fast, put more effect into each bit of the
   story, needs 10x the craftsmanship").
   Keep the lowercase, the fragments and the bluntness: they are the evidence. The colophon says so.
   Rules of the page: the film plays first; headings say what happened, with no morals;
   the turning-point prompts are set large (.shout); every number is sourced in the colophon.
   Copy rules (20 Nov 2026 de-slop pass): no "not X, it's Y", no aphorisms, no reaction lines,
   no feelings Radu did not type. "The point" is built from his own sentences. */

const base = '/stories/this-is-not-it'
const film = { versions: 25, seconds: 119.5, fps: 30, bpm: 120, pictures: 49 }

/** The LinkedIn post that started it. Source: LinkedIn post analytics export, 20 November 2026. */
const post = { at: '9:08', impressions: 13866, reached: 8432, reactions: 49, comments: 32, saves: 30, profileViews: 135 }

/* Times in the gutter are Bucharest time on 20 November 2026, then on Monday 23 November. They come from the timestamps of
   the files themselves (pictures and cuts), the LinkedIn export (the post) and the chat (my notes). */
const frames = Math.round(film.seconds * film.fps)
const length = `${Math.floor(film.seconds / 60)}:${String(Math.floor(film.seconds % 60)).padStart(2, '0')}`

/** Interim cuts that can be played. Lengths come from the files; verdicts are mine. */
const cut = {
  1: { v: 1, at: '12:17', len: '1:02', verdict: 'A start.', note: 'Small illustrated workmen and too many sizes of type.' },
  2: { v: 2, at: '12:27', len: '0:51', verdict: 'In a hurry.', note: 'One size of type, more sound. My note: “not bad v2, think you need to work on rhythm and dramatism.”' },
  3: { v: 3, at: '12:52', len: '0:44', verdict: 'Wrong direction.', note: 'Seven seconds shorter than version 2. My note had asked for rhythm and drama.' },
  4: { v: 4, at: '13:08', len: '1:28', verdict: 'The one that stuck.', note: 'Started again without the illustrations. Each line has its own animation.' },
  5: { v: 5, at: '13:39', len: '1:28', verdict: 'Horrific.', note: 'A 3D key, as requested.' },
  8: { v: 8, at: '14:15', len: '1:51', verdict: 'Kept.', note: 'A photograph of a key, a finger in four frames, and a selection box that gives up and leaves.' },
  11: { v: 11, at: '15:05', len: '1:51', verdict: 'On the beat.', note: `The whole picture retimed to ${film.bpm} beats a minute.` },
  13: { v: 13, at: '15:19', len: '1:51', verdict: 'Half right.', note: 'All nature: wood, stone, water, leaves.' },
  16: { v: 16, at: '16:18', len: '1:51', verdict: 'Amazing. Still not it.', note: 'The page became a card with a hole in it, and the card fell away.' },
  22: { v: 22, at: 'Fri 17:29', len: '1:49', verdict: 'Friday’s last cut.', note: 'Soft piano, a beach behind the page.' },
  23: { v: 23, at: 'Mon 11:34', len: '1:59', verdict: 'After my notes.', note: 'Rocket clouds, a tombstone for rectangle tools, a pencil sketch, rolling credits.' },
  25: { v: 25, at: 'Mon 11:49', len: '1:59', verdict: 'After the rhythm pass.', note: 'This one plays piano and nylon guitar. There are soft and electric piano versions too.' },
}

/** Monday 23 November: the notes I sent on the film, by scene, in my words (spelling fixed). */
const monday = [
  [2, 'transitions must preserve at least one element so it feels natural.'],
  [3, 'ship it still feels weak, can we get some actual booster rocket clouds forming at bottom as it launches?'],
  [7, 'Last year, the rectangle pulling tools drew their last breath. Didn’t suffer, they just went away.'],
  [12, 'think we need to hold a few extra seconds on this screen.'],
  [15, 'Not long. Keep it fun.'],
]

/** The afternoon the ending was made, by the clock (Bucharest, 20 November 2026):
    what I typed and when, then the version that came back and when its file was written. */
const afternoon = [
  { at: '15:59', said: 'transition here is lazy.', v: 14, back: '16:08', got: 'Every shape gets its own selection box.', alt: 'Nine pastel shapes, each inside its own selection box, above the line Push it.' },
  { at: '16:01', said: 'or rather have just the drag handles, but the whole bg is a photo', v: 14, back: '16:08', got: 'The photo fills the frame. The handles stay.', alt: 'A photo of leaves fills the frame, with eight selection handles and the line That’s it.' },
  { at: '16:16', said: 'like they were a window into something, or the page was a cardboard with a cutout in the center', v: 16, back: '16:18', got: 'The page is a card with a hole in it. It falls.', alt: 'A paper card with a photo-shaped hole tilting as it falls, the handles left behind.' },
  { at: '16:24', said: 'amazing, put my x handle in there on the final card.', v: 17, back: '16:27', got: 'My handle is on the last card.', alt: 'The leaves with That’s it. and the credit Radu Ceuca, @raduceuca, wcgw.fun.' },
  { at: '16:40', said: 'Need one final touch of cinematography genius there', v: 18, back: '16:46', got: 'The last frame says “This is it.”', alt: 'The leaves with the line This is it.' },
  { at: '16:49', said: 'this is not it → this is "still" not it → this is it?', v: 19, back: '16:52', got: 'The middle state.', alt: 'The photo of leaves selected inside a paper page, above the line This is still not it.' },
  { at: '16:52', said: 'took a quarter of a century should move to final slide with full bleed picture, right?', v: 20, back: '16:58', got: 'The quarter of a century is on the last frame.', alt: 'The leaves with This is it. Took a quarter of a century.' },
  { at: '17:11', said: 'the image must have a deeper meaning.', v: 21, back: '17:15', got: 'A Caribbean beach. The wireframe is gone.', alt: 'A photo of a palm over turquoise water selected inside a paper page, above the line This is still not it.' },
]

/** Things I typed that day that lean on the word "it", in order. Spelling fixed, nothing else. */
const its = [
  'does it work? will people get it?',
  'Is there wordplay here that we can use for it?',
  'Think of it like a short story, and I want to post it to X.',
  'This is not it. It’s the title. It’s like a book.',
  'I don’t need it to move. It can be static.',
  'You select it as if it was an image, but then you get to actually push it',
  'this is it should be on the final final frame',
  'the rhythmicity of it stood out. then it hit me.',
  'no real reason, sometimes it’s gut',
]
/** Split a line around every whole word "it", so each one can be set like the film sets it. */
const mark = (line: string) => line.split(/\b(it)\b/i)
---

<BaseLayout
  title="This is not it. How a picture became a film."
  description={`I asked for a picture for a LinkedIn post and ended up with a ${length} film. The whole thread, in order, with what I typed.`}
  social={`I asked for a picture for a LinkedIn post. ${film.versions} versions later it was a film. Here is the whole thread, in order.`}
  page={pages.thisIsNotIt}
  image={`${base}/og.png`}
  creator="@raduceuca"
>
  <a href="#s1" class="skip">Skip to the story</a>

  <div class="page">
    <header class="masthead">
      <a class="home" href="/" aria-label="WCGW home"><Logo /></a>
    </header>

    <main>
      <section class="hero wide" id="film">
        <div class="hero-film">
          <video data-hero autoplay muted loop playsinline preload="metadata" poster={`${base}/poster.jpg`} width="1080" height="1350">
            <source src={`${base}/this-is-not-it.mp4`} type="video/mp4" />
          </video>
          <p class="hero-bar">
            <button class="link" type="button" data-sound data-on="Sound on" data-off="Sound off" aria-pressed="false">Sound on</button>
            <span><abbr class="fact" title={`${film.seconds} seconds`}>{length}</abbr>, playing now</span>
          </p>
        </div>
        <div class="hero-copy">
          <h1>
            <span class="beat">I asked for a picture for a post.</span>
            <span class="beat">I got a film.</span>
            <span class="beat">This is <span class="cut">not</span> <em>it.</em></span>
          </h1>
          <p class="lede">
            At 00:52 on a Friday I had a picture for a LinkedIn post. At 17:29 the same day I had a film.
            On Monday I gave it one more round of notes. Here are both days in order, with what I typed.
            <a class="link" href="/stories">A WCGW story</a>.
          </p>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s1">
        <p class="gutter"><span class="num">00:52</span> A picture</p>
        <div class="body">
          <h2 id="s1">Ioana Teleanu asked a question.</h2>
          <p>
            She asked designers who left Figma what they use instead. Her read on the answers: most didn’t
            really leave. I did, late last year. That didn’t fit in a comment, so I wrote a post, and the
            post needed a picture.
          </p>
          <blockquote class="prompt">
            <p>“Writing this post on LinkedIn, create a nice visual for it with the help of Tony”</p>
          </blockquote>
          <p>
            Tony is the guide inside <a class="link" href="https://getamplifiers.com" rel="noopener">Amplifiers</a>.
            Three pictures came back.
          </p>
          <figure class="shots three">
            <div>
              <div><img src={`${base}/01-a.webp`} alt="An empty blue selection box with a rope pulling one corner, above the word Left." width="640" height="800" loading="lazy" /><p class="v">A. I picked this one.</p></div>
              <div><img src={`${base}/01-b.webp`} alt="A row of small robots combing an orange scribble into a browser window." width="640" height="800" loading="lazy" /><p class="v">B. Robots.</p></div>
              <div><img src={`${base}/01-c.webp`} alt="An old beige monitor next to a laptop on a desk." width="640" height="800" loading="lazy" /><p class="v">C. An old monitor.</p></div>
            </div>
          </figure>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s2">
        <p class="gutter"><span class="num">00:58</span> A pick</p>
        <div class="body">
          <h2 id="s2">I picked A.</h2>
          <p>A is the box you drag in a design tool, with nothing in it, and one word under it. I asked for more of it.</p>
        </div>
      </section>

      <figure class="bleed">
        <div class="strip four">
          <img src={`${base}/02-tombstone.webp`} alt="A grey stone slab on grass inside a selection box, with a dead rose, above the word Left." width="640" height="800" loading="lazy" />
          <img src={`${base}/02-voice.webp`} alt="A black voice waveform bursting through a selection box." width="640" height="800" loading="lazy" />
          <img src={`${base}/02-bin.webp`} alt="A crumpled selection box on the floor next to a waste bin." width="640" height="800" loading="lazy" />
          <img src={`${base}/02-dragged.webp`} alt="A selection box almost entirely dragged off the page." width="640" height="800" loading="lazy" />
        </div>
        <figcaption class="cap"><div class="row"><p class="body">Four more came back. The first is a grave for a rectangle.</p></div></figcaption>
      </figure>

      <section class="act row step" aria-labelledby="s3">
        <p class="gutter"><span class="num">01:03</span> A grave</p>
        <div class="body">
          <h2 id="s3">Three notes on a tombstone.</h2>
          <blockquote class="prompt">
            <p>“continue refining tombstone concept”</p>
            <p>“1st one. Perhaps the Left. could use some tuning? does it work? will people get it?”</p>
            <p>“can we use bold, not ultrabold for left? and maybe make it a wee bit smaller? think apple ads from 80s quality”</p>
          </blockquote>
          <figure class="shots three">
            <div>
              <div><img src={`${base}/03-epitaph.webp`} alt="The tombstone with an epitaph carved into it." width="640" height="800" loading="lazy" /><p class="v">Try one. An epitaph.</p></div>
              <div><img src={`${base}/03-badge.webp`} alt="The tombstone with a small blue size badge under it." width="640" height="800" loading="lazy" /><p class="v">Try two. A size badge.</p></div>
              <div><img src={`${base}/03-final.webp`} alt="The final poster: a selected tombstone and the word Left. in bold." width="640" height="800" loading="lazy" /><p class="v">The one I posted.</p></div>
            </div>
          </figure>
          <p>It was three minutes past one in the morning. That was the picture for the post.</p>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s3b">
        <p class="gutter"><span class="num">09:08</span> Posted</p>
        <div class="body">
          <h2 id="s3b">It went on LinkedIn eight hours later.</h2>
          <p>
            By the evening it had
            <abbr class="fact" title={`${post.impressions.toLocaleString('en-US')} impressions, ${post.reached.toLocaleString('en-US')} people reached. LinkedIn post analytics export, 20 November 2026`}>about 14,000 impressions</abbr>,
            <abbr class="fact" title="LinkedIn post analytics export, 20 November 2026">{post.comments} comments and {post.saves} saves</abbr>.
            A quarter of the people who saw it were product designers. Some of them work at Figma.
          </p>
          <p>It did really well.</p>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s4">
        <p class="gutter"><span class="num">12:04</span> A word</p>
        <div class="body">
          <h2 id="s4">My post kept saying “it”.</h2>
          <p>
            The spark happened while reading my post back to myself. The rhythmicity of it stood out:
            shapes it, tries to break it, explores it, builds it. Then it hit me.
          </p>
          <blockquote class="prompt">
            <p>“Is there wordplay here that we can use for it?”</p>
            <p>“Think of it like a short story, and I want to post it to X.”</p>
            <p>“Maybe you can start with a funny thing about design.”</p>
          </blockquote>
          <p>
            It came back as a short story called <em>This is not it</em>. It opens: funny thing about
            design, it’s always about it.
          </p>
          <figure class="shots four">
            <div>
              <div><img src={`${base}/05-it.webp`} alt="The word it. inside a selection box." width="640" height="800" loading="lazy" /></div>
              <div><img src={`${base}/05-not-it.webp`} alt="A grey placeholder rectangle above the line This is not it." width="640" height="800" loading="lazy" /></div>
              <div><img src={`${base}/05-f12.webp`} alt="A beige F12 key inside a selection box." width="640" height="800" loading="lazy" /></div>
              <div><img src={`${base}/05-thats-it.webp`} alt="A wireframe next to a real website, above the line That’s it." width="640" height="800" loading="lazy" /></div>
            </div>
            <figcaption>The second picture is now the first frame of the film. The third is the key at the end.</figcaption>
          </figure>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s5">
        <p class="gutter"><span class="num">12:07</span> A book</p>
        <div class="body">
          <h2 id="s5">It tried to be a book.</h2>
          <blockquote class="prompt">
            <p>“This is not it. It’s the title. It’s like a book.”</p>
          </blockquote>
          <p>A set of illustrated plates came back, laid out as an article. I thought the visuals were amazing. The format worried me.</p>
          <figure class="loop">
            <video data-loop autoplay muted loop playsinline preload="metadata" poster={`${base}/book.webp`} width="600" height="750">
              <source src={`${base}/book.mp4`} type="video/mp4" />
            </video>
            <figcaption>The book, top to bottom. It was built as a preview for an X article.</figcaption>
          </figure>
          <blockquote class="shout">
            <p>“I don’t know if this format is ever going to work”</p>
            <footer>Me, looking at my own book.</footer>
          </blockquote>
        </div>
      </section>

      <figure class="bleed">
        <img class="wide-img" src={`${base}/06-museum-wide.webp`} alt="A wireframe in a gold frame on a museum wall, behind a rope." width="1600" height="992" loading="lazy" />
        <figcaption class="cap"><div class="row"><p class="body">One of the plates. It is the museum scene in the film.</p></div></figcaption>
      </figure>

      <section class="act row step" aria-labelledby="s6">
        <p class="gutter"><span class="num">12:17</span> A film</p>
        <div class="body">
          <h2 id="s6">Sixty seconds came back.</h2>
          <blockquote class="prompt">
            <p>“Starting from these images, can we make a 60-second video manifesto with web technologies? Kinetic typography and lots of small animations. Apple had one that only used a dot.”</p>
          </blockquote>
          <p>
            The film is a web page. It has a function that takes a time and draws that moment. A browser
            with no window opens the page
            <abbr class="fact" title={`${film.seconds} s × ${film.fps} frames a second`}>{frames.toLocaleString('en-US')}</abbr>
            times and takes a screenshot each time. There is no editor and no timeline anywhere.
          </p>
          <StoryDeck base={base} cuts={[cut[1]]} />
          <blockquote class="prompt">
            <p>“imagine you are at apple and Steve Jobs is reviewing this tomorrow morning”</p>
          </blockquote>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s7">
        <p class="gutter"><span class="num">12:27</span> Too fast</p>
        <div class="body">
          <h2 id="s7">Version 3 came back seven seconds shorter.</h2>
          <p>Three versions in forty-one minutes.</p>
        </div>
      </section>

      <figure class="wide trio">
        {
          [cut[2], cut[3], cut[4]].map((c) => (
            <div class="tv">
              <video controls playsinline preload="none" poster={`${base}/cut-v${c.v}.webp`} width="544" height="680">
                <source src={`${base}/cut-v${c.v}.mp4`} type="video/mp4" />
              </video>
              <p class="meta">Version <span class="num">{c.v}</span> · <span class="num">{c.at}</span> · <span class="num">{c.len}</span></p>
              <p>{c.verdict}</p>
              <p class="note">{c.note}</p>
            </div>
          ))
        }
      </figure>

      <section class="row after">
        <div class="body">
          <blockquote class="shout">
            <p>“feels too fast. every beat of the story needs its own idea.”</p>
            <footer>Me, after version 3.</footer>
          </blockquote>
          <p>Version 4 dropped the illustrations and started again.</p>
        </div>
      </section>

      <section class="act night" aria-labelledby="s8">
        <div class="row">
          <p class="gutter"><span class="num">13:39</span> A key</p>
          <div class="body">
            <h2 id="s8">I asked for a 3D key.</h2>
            <p>
              The film ends on an F12 key. In Dreamweaver, F12 opened your page in the browser. I wanted the
              key to feel physical, so I asked for this:
            </p>
            <blockquote class="prompt">
              <p>“do the f12 key real, a 3d render, or something that gets pushed as the climax”</p>
            </blockquote>
          </div>
        </div>

        <div class="wide duo">
          <blockquote class="shout">
            <p>“Oh no, the 3D you did is just horrific.”</p>
            <footer>Me, after version 5.</footer>
          </blockquote>
          <figure class="cmpfig">
            <StoryCompare
              before={`${base}/key-3d.webp`}
              after={`${base}/key-real.webp`}
              beforeLabel="Version 5"
              afterLabel="Version 8"
              alt="A photographed beige F12 key with a fingertip pressing it, compared with a glossy 3D render of the same key."
            />
            <figcaption>Drag the line. Version 5 is a render. Version 8 is a photograph with a finger on it.</figcaption>
          </figure>
        </div>

        <div class="wide duo flip">
          <figure class="press">
            <button class="key" type="button" data-press data-f="0" aria-label="Press the F12 key">
              <img src={`${base}/press-0.webp`} alt="A beige F12 key on paper." width="820" height="1025" loading="lazy" />
              <img src={`${base}/press-1.webp`} alt="" width="820" height="1025" loading="lazy" />
              <img src={`${base}/press-2.webp`} alt="" width="820" height="1025" loading="lazy" />
              <img src={`${base}/press-3.webp`} alt="" width="820" height="1025" loading="lazy" />
            </button>
            <figcaption>
              The key from version 8, and a finger in four frames.
              <span class="jsonly">Press it. F12 on your own keyboard works too.</span>
            </figcaption>
          </figure>
          <div class="side">
            <blockquote class="prompt">
              <p>“It’s a real button. You select it as if it was an image, but then you get to actually push it”</p>
              <p>“must see how the f12 button is pressed, even if you render this as stop motion animation and png sequence”</p>
            </blockquote>
            <StoryDeck base={base} cuts={[cut[5], cut[8]]} />
          </div>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s9">
        <p class="gutter"><span class="num">15:05</span> A piano</p>
        <div class="body">
          <h2 id="s9">The piano was off the beat.</h2>
          <blockquote class="prompt">
            <p>“think we need piano sounds, look at this”</p>
          </blockquote>
          <p>The link was Apple’s “Designed by Apple in California” ad.</p>
          <blockquote class="prompt">
            <p>“piano piece is not in sync or related to the rest of the video, seems like bad mixing / mastering”</p>
          </blockquote>
          <p>
            To fix that, the whole picture was retimed to
            <abbr class="fact" title="The tempo of the score from version 11 on">{film.bpm}</abbr> beats a minute, so
            the cuts land on beats. Nobody plays the piano. The notes are written out in code.
          </p>
          <StoryDeck base={base} cuts={[cut[11]]} />
          <blockquote class="shout">
            <p>“I am NOT a robot, right?”</p>
            <footer>Me, hearing a synthetic voice play me.</footer>
          </blockquote>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s10">
        <p class="gutter"><span class="num">15:19</span> Twigs</p>
        <div class="body">
          <h2 id="s10">Twigs, then half twigs, then hammers.</h2>
          <blockquote class="shout">
            <p>“each sound must come from nature, like a twig snapping. think of the volvo turn signal.”</p>
            <footer>Me, about the clicks.</footer>
          </blockquote>
          <p>
            <a class="link" href="https://news.yahoo.com/volvo-snapped-stick-turn-signal-175500792.html" rel="noopener">Volvo built its turn signal from a snapped stick</a>.
            I wanted that, so every beep became wood, stone, water and leaves.
          </p>
          <p class="hear">
            Hear them:
            <button class="link" type="button" data-snd={`${base}/snd-beep.wav`}>the beep</button>,
            <button class="link" type="button" data-snd={`${base}/snd-twig.wav`}>a twig</button>,
            <button class="link" type="button" data-snd={`${base}/snd-hammer.wav`}>a small hammer</button>.
          </p>
          <StoryDeck base={base} cuts={[cut[13]]} />
          <blockquote class="prompt">
            <p>“natural sounds need more work, maybe meet half way natural and the ones you had before”</p>
            <p>“the water sounds in the beginning make no sense, need something that is more work related? workshop sounds?”</p>
          </blockquote>
          <p>The film now clicks in twigs and small hammers.</p>
        </div>
      </section>

      <section class="act row step" aria-labelledby="s11">
        <p class="gutter"><span class="num">15:59</span> An ending</p>
        <div class="body">
          <h2 id="s11">Seven endings in one afternoon.</h2>
          <p>
            The last ten seconds changed
            <abbr class="fact" title="Versions 14, 16, 17, 18, 19, 20 and 21 all changed the ending">seven</abbr>
            times. These are my notes from that afternoon, with the time I sent each one and what came back.
          </p>
        </div>
      </section>

      <div class="wide reel" data-reel>
        {
          afternoon.map((n, i) => (
