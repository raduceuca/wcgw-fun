  @keyframes huh {
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }
  .word { white-space: nowrap; }
  .hunt + .row + .act { margin-top: var(--act-space); }
  .it {
    position: relative;
    font-style: italic;
  }
  .it::after {
    content: '';
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    bottom: -0.12em;
    height: 0.22em;
    background: var(--pencil);
    -webkit-mask: var(--mark-line-1) 0 0 / 100% 100% no-repeat;
    mask: var(--mark-line-1) 0 0 / 100% 100% no-repeat;
    pointer-events: none;
  }
  .word:nth-of-type(even) .it::after {
    -webkit-mask-image: var(--mark-line-2);
    mask-image: var(--mark-line-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .it::after {
