    .its li:nth-child(7n + 3) { --r: 1.2deg; grid-column: 3 / 8; justify-self: start; }
    .its li:nth-child(7n + 4) { --s: 1.2; --r: -2deg; --w: 15em; grid-column: 1 / 7; grid-row: 3; }
    .its li:nth-child(7n + 5) { --s: 1.75; --r: 3.5deg; grid-column: 7 / 13; grid-row: 2 / span 2; align-self: center; }
    .its li:nth-child(7n + 6) { --s: 1.35; --r: 2deg; grid-column: 2 / 8; margin-top: 0.8rem; }
