  }
  .bar:global(.on), .bar:focus-within { translate: 0 0; } /* tabbing into it shows it, even at the top */
  @media (prefers-reduced-motion: reduce) { .bar { transition: none; } }
  .mini { width: 1.6rem; height: 1.6rem; flex: none; }
  .now { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* the stems, in the order the page brings them in: lit while heard, a tick on every hit */
  .stems { display: flex; align-items: flex-end; gap: 3px; height: 0.95rem; flex: none; cursor: help; }
  .stems i { width: 3px; height: 100%; background: var(--ink); opacity: 0.18; transform-origin: 50% 100%; transition: opacity 0.8s; }
  .stems i:global(.in) { opacity: 0.9; }
  .now .num { margin-inline: 0.4em 0.2em; font-size: 0.86em; }
  .time { color: var(--soft); font-size: 0.82em; cursor: help; }
  .sound {
    padding: 0.25em 0.7em;
    border: 1px solid var(--hair);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font-size: 0.78em;
    cursor: pointer;
  }
  .sound { position: relative; }
  .sound::after { content: ''; position: absolute; inset: -0.9rem -0.4rem; } /* a thumb-sized target, the pill stays small */
  .sound[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .sound:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .fill { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--ink); transform-origin: 0 50%; transform: scaleX(0); }
  @media (max-width: 34rem) { .time { display: none; } }

  /* ================================================================ the front */
  .hero {
    position: relative;
    display: grid;
    width: var(--wide);
    margin-inline: var(--out);
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    padding-bottom: var(--act-space);
  }
  .kicker { color: var(--soft); font-family: var(--sans); font-size: 0.72em; letter-spacing: 0.14em; text-transform: uppercase; }
  .hero h1 { margin-top: 0.5em; font-size: clamp(2.7rem, 1.2rem + 5.6vw, 5.7rem); line-height: 0.98; letter-spacing: -0.022em; }
  .hero h1 .beat { text-wrap: balance; }
  .hero .lede { margin-top: 1.6rem; max-width: 26rem; color: var(--soft); }
  .hero .lede .link { color: var(--ink); }
  .deck { margin: 2.5rem 0 0; justify-self: center; width: min(100%, 30rem); }
  .deck .record { width: 100%; }
  .hint { margin-top: 1.4rem; color: var(--ink); font-family: var(--sans); font-size: 0.72em; letter-spacing: 0.12em; text-transform: uppercase; }
  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      /* the record spans the lede, the hint and a filler row, so the hint sits right under the lede */
      grid-template-areas: 'kicker kicker' 'title title' 'lede deck' 'hint deck' '. deck';
      grid-template-rows: auto auto auto auto 1fr;
      align-items: start;
    }
    .hint { grid-area: hint; }
    .kicker { grid-area: kicker; }
    .hero h1 { grid-area: title; }
    .hero .lede { grid-area: lede; margin-top: 2.2rem; }
    .deck {
      grid-area: deck;
      width: min(54vw, 44rem);
      margin-top: -1.5rem;
      justify-self: end;
      margin-right: calc(min(50vw - 1.375rem, 33rem) - 50vw);
    }
  }
  .record { display: block; height: auto; aspect-ratio: 1; touch-action: none; user-select: none; cursor: grab; }
  .record:global(.held) { cursor: grabbing; }
  .record:focus-visible { outline: 2px solid var(--ink); outline-offset: 6px; border-radius: 50%; }

  /* The front arrives in three beats, and the record sinks as you scroll away from it */
  @media (prefers-reduced-motion: no-preference) {
    .rise { animation: rise 0.9s var(--ease-pencil) both; animation-delay: calc(var(--d) * 140ms + 100ms); }
    .deck .record { scale: calc(1 - var(--p, 0) * 0.18); }
  }
  @keyframes rise { from { opacity: 0; translate: 0 0.5em; } }

  /* The paper pencil */
  .under { position: relative; white-space: nowrap; }
  .under::after {
    content: '';
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    bottom: -0.06em;
    height: 0.14em;
    background: var(--pencil);
    -webkit-mask: var(--mark-line-1) 0 0 / 100% 100% no-repeat;
    mask: var(--mark-line-1) 0 0 / 100% 100% no-repeat;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .under::after { clip-path: inset(0 100% 0 0); transition: clip-path 0.6s var(--ease-pencil) 0.7s; }
    :global(.js) .under:global(.is-in)::after { clip-path: inset(0); }
  }

  /* ================================================================ tracklist */
  .tracks { padding-block: 1.4rem; border-block: 1px solid var(--hair); }
  .tracks ol { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; row-gap: 0.2em; }
  .tracks a { position: relative; color: inherit; text-decoration: none; transition: color 0.3s; }
  .tracks a:hover, .tracks a:focus-visible { text-decoration: underline; text-underline-offset: 0.2em; }
  .tracks a:global(.playing) .side { color: var(--ink); }
  .tracks a:global(.playing)::before { content: '▸'; position: absolute; left: -1em; font-size: 0.8em; top: 0.15em; }
  .side { display: inline-block; min-width: 2.2em; color: var(--soft); font-family: var(--sans); font-size: 0.72em; letter-spacing: 0.08em; }
  .gutter .side { min-width: 0; margin-right: 0.5em; }

  /* ================================================================ the notes */
  .rant { color: var(--soft); font-style: italic; }
  .act .body > .big + p { margin-top: 1.2em; }
  .after { padding-top: 2rem; }

  /* "the same." arrives as three takes that slide into one */
  .echo { position: relative; display: inline-block; }
  .echo::before,
  .echo::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: calc(0.45 * (1 - var(--e, 1)));
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .echo::before { translate: calc((1 - var(--e, 1)) * -0.9em) calc((1 - var(--e, 1)) * -0.35em); }
    .echo::after { translate: calc((1 - var(--e, 1)) * 0.9em) calc((1 - var(--e, 1)) * 0.35em); }
  }
  /* the section's --e has to reach the echo */
  .act[data-p] .echo { --e: inherit; }


  /* The objections come in, in order */
  .objections dt { margin-top: 1.4em; font-size: 1.12em; }
  .objections dt:first-child { margin-top: 0.4em; }
  .objections dd { margin: 0.35em 0 0; color: var(--soft); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .objections dt,
    :global(.js) .objections dd {
      opacity: 0;
      translate: -1.2rem 0;
      transition: opacity 0.6s, translate 0.7s var(--ease-pencil);
      transition-delay: calc(var(--i) * 380ms);
    }
    :global(.js) .objections dd { transition-delay: calc(var(--i) * 380ms + 120ms); }
    :global(.js) .objections:global(.is-in) dt,
    :global(.js) .objections:global(.is-in) dd { opacity: 1; translate: 0 0; }
  }

  /* ================================================================ the pictures, straight on the sleeve */
  .fig { width: var(--wide); margin: var(--act-space) 0 0; margin-inline: var(--out); }
  .fig img { display: block; width: 100%; height: auto; }
  .fig figcaption { width: min(100%, var(--gutter) + var(--gap) + var(--measure)); margin-inline: auto; }

  @media (prefers-reduced-motion: no-preference) {
    /* Fig. 1: the tape goes into the deck */
    .slide .tapes { translate: calc((1 - var(--e, 1)) * -45vw) 0; rotate: calc((1 - var(--e, 1)) * -9deg); opacity: calc(0.2 + var(--e, 1) * 0.8); }
    /* Fig. 2: the mic comes down on its rod, out of the top edge of its own frame, never over the words above */
    .drop { clip-path: inset(0 -100vw -100vw -100vw); }
    .drop .hang { translate: 0 calc((1 - var(--e, 1)) * -42%); }
    /* Fig. 4: the studio opens up */
    .build img, .build .over { scale: calc(0.86 + var(--e, 1) * 0.14); opacity: calc(var(--e, 1) * 1.4 - 0.2); }
  }

  /* Fig. 1, the demos: an endless row of cassettes (tapes.py cut them), the one in front bigger. It sings
     the record; tap it and it plays its demo, its hubs turning while it does. */
  .slide { position: relative; }
  .tapes {
    /* the row runs the whole window wide, so the tapes go on past its edges; room above and below for
       the shadows (a scrolling box clips whatever spills out of it) */
    --slide: clamp(15rem, 34vw, 30rem);
    display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
    scrollbar-width: none; outline: none; touch-action: pan-x pan-y; cursor: grab;
    width: 100vw; margin-inline: calc(50% - 50vw); padding-block: 2.5rem; margin-block: -2.5rem;
  }
  .tapes::-webkit-scrollbar { display: none; }
  .tapes:global(.dragging), .tapes:global(.jumping) { scroll-snap-type: none; }
  .tapes:global(.dragging) { cursor: grabbing; }
  @media (max-width: 40rem) { .tapes { --slide: 74vw; } }
  /* each slide is cropped to its cassette: the picture (16:9, the tape 59% of it) zoomed so the tape fills it */
  .tape-slide {
    --near: 1; /* 1 in front, 0 a slide or more away: the script writes it as the row moves */
    position: relative; flex: 0 0 var(--slide); aspect-ratio: 3 / 2; scroll-snap-align: center;
    opacity: calc(0.35 + var(--near) * 0.65);
  }
  .tape-in { position: absolute; left: 0; top: 50%; width: 100%; translate: 0 -50%; scale: calc(1.5 * (0.74 + var(--near) * 0.26)); }
  .tape-in img { user-select: none; -webkit-user-drag: none; }
  .tape {
    position: absolute; left: 0; top: 0; width: 100%; aspect-ratio: 16 / 9; pointer-events: none;
  }
  .reel { position: absolute; aspect-ratio: 1; background-size: 100%; }
  .tape-hit { position: absolute; left: 20.5%; top: 16.7%; width: 59%; height: 63.8%; border: 0; border-radius: 3% / 5.3%; background: none; cursor: pointer; pointer-events: auto; }
  .tape-hit:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }

  /* Layers cut from a figure's own render, laid exactly over it */
  .build, .pads .dev-in { position: relative; }
  .over { position: absolute; left: 0; top: 0; width: 100%; aspect-ratio: 2400 / 1350; pointer-events: none; }
  .cone { position: absolute; aspect-ratio: 1; background-size: 100%; }
  /* Fig. 4: the congas play (cut by studio.py); the woofers pump with the kick */
  .conga {
    position: absolute; top: 45.926%; height: 28.148%; padding: 0; border: 0; background: none; background-size: 100% 100%;
    transform-origin: 50% 100%; cursor: pointer; pointer-events: auto; border-radius: 30% 30% 12% 12% / 12% 12% 6% 6%;
  }
  /* a hand is bigger than the drawn drum: the hit area reaches past the shell (the right drum wins the middle) */
  .conga::before { content: ''; position: absolute; inset: -12% -30%; }
  .conga:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* Fig. 6: the pad controller. Cropped to the device, edge to edge on phones, so the pads are big enough to hit. */
  /* crop: x 12% to 90%, y 15% to 88% of the render, wide enough that the shadow fades out before the edge */
  .pads .dev { position: relative; overflow: hidden; max-width: 56rem; margin-inline: auto; aspect-ratio: 1872 / 985.5; }
  .pads .dev-in { position: absolute; width: 128.205%; left: -15.385%; top: -20.548%; container-type: inline-size; }
  .pads .dev-in img { display: block; width: 100%; height: auto; }
  @media (max-width: 40rem) { .pads .dev { margin-inline: -1.375rem; } }
  .key {
    position: absolute; width: 6.917%; height: 12.296%; padding: 0; border: 0; border-radius: 9.6%; background: none;
    cursor: pointer; pointer-events: auto; touch-action: manipulation; -webkit-tap-highlight-color: transparent;
  }
  /* The pads are dark translucent plastic, lit from inside. The light (the face brightening, the spill on
     the body around it) is in the picture, one layer per pad, cut by pads.py: the page only fades it. */
  .key .lit {
    position: absolute; inset: -43.373%; background-size: 100% 100%; pointer-events: none;
    opacity: 0; transition: opacity 0.55s ease-out;
  }
  .key:global(.on) .lit { opacity: 1; transition: none; }
  /* the key that plays it, printed small on the pad */
  .key .legend {
    position: absolute; left: 11%; bottom: 9%; font-family: var(--sans); font-weight: 500; font-size: max(0.72cqi, 7px);
    letter-spacing: 0.04em; line-height: 1; color: #fafafa; opacity: 0.4; transition: opacity 0.55s ease-out; pointer-events: none;
  }
  .key:global(.on) .legend { opacity: 0.95; transition: none; }
  .key:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .knob {
    position: absolute; width: 6.25%; aspect-ratio: 1; background-size: 100%; border-radius: 50%;
    rotate: calc(var(--v, 0.5) * 270deg - 135deg); cursor: ns-resize; pointer-events: auto; touch-action: none; outline: none;
  }
  .knob:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .screen {
    position: absolute; left: 18.417%; top: 22.667%; width: 10.25%; height: 9.481%; margin: 0; padding: 0 0.7cqi;
    display: flex; align-items: center; overflow: hidden; white-space: nowrap;
    font-family: 'Instrument Sans', sans-serif; font-size: max(1.05cqi, 8.5px); letter-spacing: 0.08em; text-transform: uppercase; color: #fafafa;
  }

  /* the monitors, standing in the outer margins once the studio is open */
  .monitors { display: none; }
  @media (min-width: 80rem) {
    .monitors { display: block; }
    .mon {
      --w: min(8.5rem, (100vw - var(--wide)) / 2 - 2rem);
      position: fixed; bottom: 1.25rem; z-index: 4; width: var(--w); pointer-events: none;
      translate: 0 135%; transition: translate 0.7s var(--ease-pencil);
    }
    .mon img { display: block; width: 100%; height: auto; }
    .mon-l { left: calc((100vw - var(--wide)) / 4 - var(--w) / 2); }
    .mon-r { right: calc((100vw - var(--wide)) / 4 - var(--w) / 2); }
    .monitors:global(.on) .mon { translate: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mon { transition: none; }
  }

  /* Fig. 2 hangs from its top edge, and swings from there. Waves come off the grille. */
  .hang { position: relative; }
  /* phones: the same tall crop as the hanging mic on wide screens, so the talent is not a sliver in a wide frame */
  @media (max-width: 47.99rem) {
    .drop .hang { width: min(8rem, 38vw); margin-inline: auto; }
    .drop img { aspect-ratio: 400 / 1350; object-fit: cover; object-position: 50% 0; }
    .drop figcaption { text-align: center; }
  }
  .hang img { transform-origin: 50% 0; cursor: pointer; }
  .hang img:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .waves { position: absolute; left: 50%; top: 86%; width: 0; height: 0; pointer-events: none; }
  .waves i { position: absolute; left: 50%; top: 50%; width: 14rem; height: 14rem; margin: -7rem 0 0 -7rem; border: 1px solid var(--ink); border-radius: 50%; opacity: 0; }
  @media (max-width: 40rem) { .waves i { width: 7rem; height: 7rem; margin: -3.5rem 0 0 -3.5rem; } } /* clear of the caption and the next heading */
  @media (prefers-reduced-motion: no-preference) {
    .drop:global(.is-in) .waves i { animation: wave 3.6s ease-out infinite; }
    .drop:global(.is-in) .waves i:nth-child(2) { animation-delay: 1.2s; }
    .drop:global(.is-in) .waves i:nth-child(3) { animation-delay: 2.4s; }
  }
  @keyframes wave { from { scale: 0.15; opacity: 0.7; } to { scale: 1.6; opacity: 0; } }

  /* Wide screens: the mic hangs from the top of the window, in the margin beside A2. It drops in as A2
     arrives, stays while A2 is on screen, and goes up with the page after it. The script writes
     --drop (0 → 1) and --lift (px) from A2's position. Words never sit under it. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 80rem) {
    :global(.js) .drop {
      --mw: min(14rem, 26vh);
      position: fixed;
      top: 0;
      right: calc((50vw - (var(--gutter) + var(--gap) + var(--measure)) / 2 - var(--mw)) / 2);
      z-index: 5;
      width: var(--mw);
      margin: 0;
      clip-path: none;
      translate: 0 calc((var(--drop, 0) - 1) * 100% + var(--lift, 0px));
    }
    :global(.js) .drop .hang { translate: none; }
    :global(.js) .drop img { aspect-ratio: 400 / 1350; object-fit: cover; object-position: 50% 0; }
    :global(.js) .drop .waves i { width: 9rem; height: 9rem; margin: -4.5rem 0 0 -4.5rem; }
    :global(.js) .drop figcaption { margin-top: -3.5rem; font-size: 0.8em; }
  }

  /* Fig. 3: a button you can press */
  .pad { position: relative; }
  /* The cap goes down in three frames cut from the same render; the bezel never moves */
  .pad .frame { position: absolute; inset: 0; height: 100%; visibility: hidden; pointer-events: none; }
  .pad[data-f='1'] .frame[data-n='1'],
  .pad[data-f='2'] .frame[data-n='2'],
  .pad[data-f='3'] .frame[data-n='3'] { visibility: visible; }
  .hit {
