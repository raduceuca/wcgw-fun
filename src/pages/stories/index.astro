---
import Logo from '../../components/Logo.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { consent } from '../../copy'
import { pages, site } from '../../site'
import '../../styles/home.css'

/* Stories: illustrated stories from the aftermath.
   Add a story by adding a page under src/pages/stories/, an entry in `pages` (src/site.ts) and a row
   below, newest first. A row whose page is a draft shows in `npm run dev` only. */
const stories = [
  {
    page: pages.theProducer,
    href: '/stories/the-producer',
    title: 'The model is the talent. You are the producer.',
    when: 'November 2026',
    about: 'Everybody’s AI output sounds the same. A rant about demos, records and saying “again”, with the takes.',
  },
  {
    page: pages.thisIsNotIt,
    href: '/stories/this-is-not-it',
    title: 'The Accidental Manifesto.',
    when: 'November 2026',
    about: 'I asked for a picture for a LinkedIn post and ended up with a two-minute film, 25 versions and a tombstone for rectangle tools.',
  },
].filter((story) => import.meta.env.DEV || !('draft' in story.page && story.page.draft))
---

<BaseLayout
  title="Stories. WCGW"
  description="Illustrated stories from the aftermath. Interactive pieces, part essay, part short story."
  social="Illustrated stories from the aftermath. Interactive pieces, part essay, part short story."
  page={pages.stories}
  image="/stories/og.png"
  imageAlt="The WCGW logo above the line: Illustrated stories from the aftermath. Interactive pieces, part essay, part short story."
>
  <div class="page">
    <header class="masthead">
      <a class="home" href="/" aria-label="WCGW home"><Logo /></a>
    </header>

    <main>
      <section class="hero">
        <h1>Illustrated stories from the aftermath.</h1>
        <p class="lede">
          Interactive pieces, part essay, part short story.
        </p>
      </section>

      <section class="act row" aria-labelledby="stories">
        <p class="gutter" id="stories">Stories</p>
        <div class="body">
          <ul class="tools">
            {
              stories.map((s) => (
                <li>
                  <p class="tool">
                    <a class="link" href={s.href}>{s.title}</a>
                    <span class="status">{"draft" in s.page && s.page.draft ? "Draft, dev only" : s.when}</span>
                  </p>
                  <p class="tool-desc">{s.about}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <footer class="row">
      <div class="body foot">
        <p>© <span id="year">2026</span> <a class="link" href="/">WCGW</a>, the studio of Radu Ceucă.</p>
        {
          site.clarityId && (
            <p>
              <a class="link" href="/privacy">{consent.privacy}</a> ·{' '}
              <button class="link" type="button" data-consent-open>{consent.reopen}</button>
            </p>
          )
        }
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .home {
    display: block;
    color: inherit;
  }
  .home:focus-visible {
    outline: 2px solid var(--pencil);
    outline-offset: 0.2em;
  }
  h1 { text-wrap: balance; }
</style>
