---
import Logo from './Logo.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { consent } from '../copy'
import { type Page, site } from '../site'
import '../styles/home.css'

/* The shell of Lookout's three pages: what it is, its privacy policy and its terms.
   TikTok's app review reads all three, and the app's web URL is the first. */
interface Props {
  page: Page
  title: string
  description: string
  label: string
}

const { page, title, description, label } = Astro.props
const updated = page.modified
const updatedLabel = updated && new Date(updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
---

<BaseLayout page={page} title={title} description={description} social={description}>
  <div class="page">
    <header class="masthead">
      <a class="home" href="/" aria-label="WCGW home"><Logo /></a>
    </header>

    <main>
      <section class="act row notice" aria-labelledby="notice">
        <p class="gutter">{label}</p>
        <div class="body">
          <slot />
          {updated && <p class="updated">Updated <time datetime={updated}>{updatedLabel}</time>.</p>}
          <p class="siblings">
            <a class="link" href="/lookout">Lookout</a> ·
            <a class="link" href="/lookout/privacy">Privacy</a> ·
            <a class="link" href="/lookout/terms">Terms</a>
          </p>
        </div>
      </section>
    </main>

    <footer class="row">
      <div class="body foot">
        <p>© <span id="year">2026</span> WCGW, the studio of Radu Ceucă.</p>
        {site.clarityId && <p><button class="link" type="button" data-consent-open>{consent.reopen}</button></p>}
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .home {
    display: block;
    color: inherit;
  }
  .home:focus-visible {
    outline: 2px solid var(--pencil);
    outline-offset: 0.2em;
  }
  .notice { margin-top: clamp(4.5rem, 3rem + 7vw, 8.75rem); }
  .notice :global(h1) { margin-top: 0; font-size: inherit; letter-spacing: 0; line-height: inherit; }
  .notice :global(h2) { font-size: inherit; color: var(--soft); }
  .notice :global(h2 + p),
  .notice :global(h2 + ul) { margin-top: 0.2em; }
  .notice :global(code) { font: inherit; font-family: var(--sans); font-size: 0.85em; }
  .updated,
  .siblings { color: var(--soft); }
</style>
