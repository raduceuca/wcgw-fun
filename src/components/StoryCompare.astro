---
/* Before and after, on one picture: drag the line across. A range input does the work,
   so it also answers to the keyboard. Behaviour lives in the story page's script (data-cmp). */
interface Props {
  before: string
  after: string
  beforeLabel: string
  afterLabel: string
  alt: string
}
const { before, after, beforeLabel, afterLabel, alt } = Astro.props
---

<div class="cmp" data-cmp style="--x: 50%">
  <img src={after} alt={alt} width="720" height="900" loading="lazy" />
  <img class="top" src={before} alt="" width="720" height="900" loading="lazy" aria-hidden="true" />
  <span class="lbl l">{beforeLabel}</span>
  <span class="lbl r">{afterLabel}</span>
  <span class="line" aria-hidden="true"></span>
  <input type="range" min="0" max="100" value="50" aria-label={`Compare ${beforeLabel} with ${afterLabel}`} />
</div>

<style>
  .cmp {
    position: relative;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--hair);
    background: var(--hair);
    overflow: hidden;
    touch-action: pan-y;
  }
  img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .top { clip-path: inset(0 calc(100% - var(--x)) 0 0); }
  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 2px;
    margin-left: -1px;
    background: var(--pencil);
  }
  .lbl {
    position: absolute;
    top: 0.5em;
    padding: 0.05em 0.45em;
    background: var(--bg);
    color: var(--soft);
    font-size: 0.78em;
    line-height: 1.5;
  }
  .l { left: 0.5em; }
  .r { right: 0.5em; }
  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .cmp:has(input:focus-visible) {
    outline: 2px solid var(--pencil);
    outline-offset: 2px;
  }
</style>
