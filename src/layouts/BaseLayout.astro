---
import ConsentBanner from '../components/ConsentBanner.astro'
import { CONSENT_KEY } from '../home/consent'
import { canonical, jsonLd, markdownPath } from '../seo'
import { type Page, site } from '../site'
import '../styles/fonts.css'

interface Props {
  title?: string
  description?: string
  themeColorLight?: string
  themeColorDark?: string
  /** A public page from `pages` (src/site.ts). Without one (the 404) the page is noindex. */
  page?: Page
  /** Write the page in like an agent's reply (src/home/stream.ts). Home only. */
  stream?: boolean
  /** Share card. Each defaults to the home page's, so existing pages are unchanged. */
  social?: string
  image?: string
  /** X handle of the person who wrote the page, for twitter:creator. */
  creator?: string
}

const {
  title = 'WCGW. What could go wrong?',
  description = 'Infinite output. An abdication of agency.',
  themeColorLight = '#fafafa',
  themeColorDark = '#161513',
  page,
  stream = false,
  social = 'Your team can ship anything now. Congratulations. What could go wrong?',
  image = '/og-image.png',
  creator = '',
} = Astro.props

const url = page ? canonical(page.path) : undefined
const graph = page && JSON.stringify(jsonLd({ page, title, description }))

/** GTM runs in production builds only, so local dev clicks stay out of the data (Clarity loads via GTM). */
const gtmId = import.meta.env.PROD ? site.gtmId : ''
---
<!DOCTYPE html>
<html lang="en" data-stream={stream ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.founder} />
    {url ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex" />}
    {page && <link rel="alternate" type="text/markdown" href={markdownPath(page.path)} />}
    {[...site.profiles.studio, ...site.profiles.founder].map(href => <link rel="me" href={href} />)}
    {graph && <script is:inline type="application/ld+json" set:html={graph} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={social} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url ?? site.url} />
    <meta property="og:image" content={`${site.url}${image}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitter} />
    {creator && <meta name="twitter:creator" content={creator} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={social} />
    <meta name="twitter:image" content={`${site.url}${image}`} />

    <meta name="theme-color" content={themeColorLight} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColorDark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      try {
        var t = localStorage.getItem('wcgw-theme')
        if (t === 'paper' || t === 'night') document.documentElement.dataset.theme = t
      } catch (e) {}
      var root = document.documentElement
      if (root.hasAttribute('data-stream') && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        root.classList.add('streaming')
      }
      root.classList.add('js')
    </script>

    <!-- The hero's face. The rest of src/styles/fonts.css loads as the text needs it. -->
    <link rel="preload" href="/fonts/eb-garamond-normal-latin.woff2" as="font" type="font/woff2" crossorigin />

    {
      gtmId && (
        <script is:inline define:vars={{ gtmId, consentKey: CONSENT_KEY }}>
          if (!window.__wcgwGtmLoaded) {
            window.__wcgwGtmLoaded = true
            window.dataLayer = window.dataLayer || []
            window.gtag = window.gtag || function () { window.dataLayer.push(arguments) }
            var granted = false
            try { granted = localStorage.getItem(consentKey) === 'yes' } catch (e) {}
            window.gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: granted ? 'granted' : 'denied',
            })
            ;(function (w, d, s, l, i) {
              w[l] = w[l] || []
              w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
              var f = d.getElementsByTagName(s)[0]
              var j = d.createElement(s)
              var dl = l !== 'dataLayer' ? '&l=' + l : ''
              j.async = true
              j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
              f.parentNode.insertBefore(j, f)
            })(window, document, 'script', 'dataLayer', gtmId)
          }
        </script>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <slot />
    {site.gtmId && <ConsentBanner />}
  </body>
</html>
